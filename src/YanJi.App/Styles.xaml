<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YanJi.App">
  <SolidColorBrush x:Key="SelectionSurface" Color="#DFE8D9" />
  <SolidColorBrush x:Key="SelectedInk" Color="#456653" />
  <SolidColorBrush x:Key="Accent" Color="#456653" />
  <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSoft" Color="#DFE8D9" />
  <SolidColorBrush x:Key="Ink" Color="#29352E" />
  <SolidColorBrush x:Key="Muted" Color="#57665A" />
  <SolidColorBrush x:Key="Canvas" Color="#F6F4EE" />
  <SolidColorBrush x:Key="Line" Color="#D9DED3" />
  <SolidColorBrush x:Key="CardBackground" Color="#FEFDF9" />
  <SolidColorBrush x:Key="Soft" Color="#EDEFE7" />
  <SolidColorBrush x:Key="Danger" Color="#A13E36" />
  <SolidColorBrush x:Key="DangerSoft" Color="#F7E8E3" />
  <SolidColorBrush x:Key="Warning" Color="#805817" />
  <SolidColorBrush x:Key="WarningSoft" Color="#F4ECD9" />
  <SolidColorBrush x:Key="NavigationBackground" Color="#ECEEE5" />
  <SolidColorBrush x:Key="NavigationInk" Color="#425448" />
  <SolidColorBrush x:Key="Hover" Color="#E1E6DA" />
  <SolidColorBrush x:Key="Pressed" Color="#354D3F" />
  <SolidColorBrush x:Key="DisabledInk" Color="#899286" />
  <SolidColorBrush x:Key="MiniSurface" Color="#E6FEFDF9" />
  <SolidColorBrush x:Key="MiniEdge" Color="#A6FFFFFF" />
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style TargetType="TextBlock" x:Key="FocusTextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource FocusTextBlock}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource FocusTextBlock}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource FocusTextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource FocusTextBlock}">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedInk}" />
  </Style>
  <Style x:Key="FilterBar" TargetType="Border">
    <Setter Property="Padding" Value="0,4,0,12" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style TargetType="Button" x:Key="FocusButton">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Margin" Value="0,0,8,4" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="local:ButtonFeedback.Animate" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Shadow" Background="#22000000" CornerRadius="8" Margin="1,3,1,-2" IsHitTestVisible="False" />
            <Grid x:Name="ButtonFace"><Grid.RenderTransform><TranslateTransform x:Name="Depress" /></Grid.RenderTransform>
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
              <Border x:Name="DepthShade" CornerRadius="8" Margin="1" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.48"/><GradientStop Color="#18000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <Border x:Name="Highlight" CornerRadius="7" Margin="1" BorderThickness="1,1,1,0" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#65FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.85"/></LinearGradientBrush></Border.BorderBrush></Border>
              <Border x:Name="Feedback" Background="{TemplateBinding Foreground}" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
              <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="11" Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="local:ButtonFeedback.Depth" Value="False"><Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/><Setter TargetName="DepthShade" Property="Visibility" Value="Collapsed"/><Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1.5"/></Setter.Value></Setter><Setter TargetName="Shadow" Property="Opacity" Value="0"/><Setter TargetName="Highlight" Property="Opacity" Value="0"/><Setter TargetName="DepthShade" Property="Opacity" Value="0.35"/><Setter TargetName="ButtonContent" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Soft}"/><Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/><Setter TargetName="DepthShade" Property="Visibility" Value="Collapsed"/><Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/><Setter Property="Opacity" Value="0.72"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            <Trigger Property="local:ButtonFeedback.State" Value="Saving"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="local:ButtonFeedback.State" Value="Success"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="Opacity" Value="1"/></Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/><Setter TargetName="DepthShade" Property="Visibility" Value="Collapsed"/><Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/></DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource FocusButton}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FocusButton}">
    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource FocusButton}">
    <Setter Property="local:ButtonFeedback.Depth" Value="False"/>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FocusButton}" />
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource QuietButton}" />
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="6" /></Style>
  <Style x:Key="NavigationItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource NavigationInk}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Item" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource SelectedInk}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledInk}" />
              <Setter Property="Opacity" Value="0.65" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" x:Key="FocusTextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Margin" Value="0,6,0,12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource NavigationInk}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledInk}" />
              <Setter Property="Background" Value="{DynamicResource Soft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem" x:Key="FocusComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Body" Padding="{TemplateBinding Padding}" CornerRadius="5">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource AccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource SelectedInk}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox" x:Key="FocusComboBox">
    <Setter Property="ItemContainerStyle" Value="{StaticResource FocusComboBoxItem}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Padding="0" Style="{x:Null}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Body" CornerRadius="8" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right" Margin="0,0,14,0" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource NavigationInk}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="12,8,36,8" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
            <Border x:Name="Focus" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledInk}" />
              <Setter Property="Opacity" Value="0.65" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DatePicker" x:Key="FocusDatePicker">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid>
            <Border x:Name="Body" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="36" />
              </Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" Foreground="{DynamicResource Ink}" Background="Transparent" BorderThickness="0" Padding="10,7" VerticalContentAlignment="Center" />
              <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource QuietButton}" Margin="0" Padding="7" MinWidth="32" ToolTip="打开日历">
                <Path Data="M2,4 L16,4 L16,17 L2,17 Z M2,8 L16,8 M6,1 L6,6 M12,1 L12,6" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="18" Height="18" />
              </Button>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
                <Calendar x:Name="PART_Calendar" Foreground="{DynamicResource Ink}" Background="{DynamicResource CardBackground}" BorderThickness="0" />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.65" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox" x:Key="FocusCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="Expander" x:Key="FocusExpander">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Margin" Value="0,4,0,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style TargetType="TreeView" x:Key="FocusTreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style TargetType="TreeViewItem" x:Key="FocusTreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,8" />
  </Style>
  <Style TargetType="ProgressBar" x:Key="FocusProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style TargetType="ToolTip" x:Key="FocusToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MaxWidth" Value="380" />
  </Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource FocusTextBlock}" />
  <Style TargetType="Button" BasedOn="{StaticResource FocusButton}" />
  <Style TargetType="TextBox" BasedOn="{StaticResource FocusTextBox}" />
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FocusComboBoxItem}" />
  <Style TargetType="ComboBox" BasedOn="{StaticResource FocusComboBox}" />
  <Style TargetType="DatePicker" BasedOn="{StaticResource FocusDatePicker}" />
  <Style TargetType="CheckBox" BasedOn="{StaticResource FocusCheckBox}" />
  <Style TargetType="Expander" BasedOn="{StaticResource FocusExpander}" />
  <Style TargetType="TreeView" BasedOn="{StaticResource FocusTreeView}" />
  <Style TargetType="TreeViewItem" BasedOn="{StaticResource FocusTreeViewItem}" />
  <Style TargetType="ProgressBar" BasedOn="{StaticResource FocusProgressBar}" />
  <Style TargetType="ToolTip" BasedOn="{StaticResource FocusToolTip}" />
  <Style x:Key="RecordItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Body" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource Soft}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Body" Property="Background" Value="{DynamicResource SelectionSurface}" />
              <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SectionSurface" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,0,16" /><Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="DenseSurface" TargetType="Border" BasedOn="{StaticResource SectionSurface}"><Setter Property="Padding" Value="12" /></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Subheading}" />
  <Style x:Key="MetaText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Margin" Value="0" /><Setter Property="LineHeight" Value="18" /></Style>
  <Style x:Key="InlineStatus" TargetType="Border" BasedOn="{StaticResource StatusBadge}"><Setter Property="CornerRadius" Value="4" /></Style>
  <Style x:Key="Toolbar" TargetType="Border" BasedOn="{StaticResource FilterBar}" />
  <Style x:Key="DurationNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="FontSize" Value="28" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
