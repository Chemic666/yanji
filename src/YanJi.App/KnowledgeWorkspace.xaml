<UserControl x:Class="YanJi.App.KnowledgeWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YanJi.App" Loaded="Workspace_Loaded" SizeChanged="Workspace_SizeChanged">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="KnowledgeTreeStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:InverseBooleanConverter x:Key="Inverse" />
    <HierarchicalDataTemplate DataType="{x:Type local:KnowledgeTreeRow}" ItemsSource="{Binding Children}">
      <StackPanel ToolTip="{Binding FullPath}" MaxWidth="220">
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Ink}" Style="{StaticResource FocusTextBlock}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
      </StackPanel>
    </HierarchicalDataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <WrapPanel DockPanel.Dock="Right">
        <Button Content="知识包" Click="Packages_Click" Style="{StaticResource QuietButton}" />
        <Button Content="科目设置" Click="Subjects_Click" Style="{StaticResource QuietButton}" />
        <Button Content="学习任务" Click="Tasks_Click" Style="{StaticResource QuietButton}" />
      </WrapPanel>
      <StackPanel><TextBlock Text="知识目录" Style="{StaticResource Heading}" /><TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource MutedText}" /></StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding Subject}" DisplayMemberPath="Name" Width="130" Margin="0,0,12,0" DockPanel.Dock="Left" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="知识目录科目" />
      <CheckBox Content="含归档" IsChecked="{Binding ShowArchived}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource FocusCheckBox}" />
      <Grid><TextBox x:Name="SearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="按节点名、路径或ID搜索" AutomationProperties.Name="搜索知识目录" Style="{StaticResource FocusTextBox}" MinWidth="120" />
        <TextBlock Text="搜索节点、路径或 ID" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
    </DockPanel>
    <Grid Grid.Row="2" x:Name="Columns">
      <Grid.ColumnDefinitions><ColumnDefinition Width=".85*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
      <Border x:Name="DirectoryPanel" Style="{StaticResource SectionSurface}" Margin="0" Padding="12">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" IsEnabled="{Binding KnowledgeBusy,Converter={StaticResource Inverse}}">
            <Button Content="＋ 根章节" Command="{Binding NewRootCommand}" Style="{StaticResource QuietButton}" />
            <Button Content="＋ 子节点" Command="{Binding NewChildCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource QuietButton}" />
          </WrapPanel>
          <Grid>
            <TreeView x:Name="DirectoryTree" ItemsSource="{Binding Roots}" SelectedItemChanged="Tree_Selected" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent">
              <TreeView.Style><Style TargetType="TreeView"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Searching}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TreeView.Style>
            </TreeView>
            <ListBox x:Name="ResultsList" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding Selected}" SelectionChanged="Search_Selected" Visibility="{Binding Searching,Converter={StaticResource Visible}}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Label}" Style="{StaticResource FocusTextBlock}" /><TextBlock Text="{Binding FullPath}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" x:Name="DetailPanel" Style="{StaticResource SectionSurface}" Margin="0" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding HasSelection,Converter={StaticResource Visible}}"><Button Content="← 目录" x:Name="BackButton" Click="Back_Click" DockPanel.Dock="Left" Style="{StaticResource QuietButton}" Visibility="Collapsed" /><TextBlock Text="节点详情" Style="{StaticResource Subheading}" /></DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection,Converter={StaticResource Visible}}">
            <StackPanel IsEnabled="{Binding KnowledgeBusy,Converter={StaticResource Inverse}}">
              <TextBlock Text="{Binding PathLabel}" Style="{StaticResource MutedText}" Margin="0,6,0,12" TextWrapping="Wrap" />
              <WrapPanel Margin="0,0,0,12"><Button Content="开始学习 →" Click="StartStudy_Click" Style="{StaticResource Primary}" AutomationProperties.Name="从知识节点开始学习" /><Button Content="添加任务" Click="AddNodeTask_Click" Style="{StaticResource QuietButton}" /><Button Content="记录薄弱点" Click="AddNodeWeak_Click" Style="{StaticResource QuietButton}" /></WrapPanel>
              <TextBox x:Name="NameBox" Text="{Binding NodeName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FocusTextBox}" FontSize="16" TextWrapping="Wrap" MaxHeight="96" AutomationProperties.Name="知识节点名称" />
              <WrapPanel Margin="0,10,0,0">
                <StackPanel Width="140" Margin="0,0,12,8"><TextBlock Text="学习状态" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{x:Static local:KnowledgeWorkspaceViewModel.StateLabels}" SelectedIndex="{Binding StateIndex}" ToolTip="未开始置0%；已学习置100%；学习中最多99%；暂缓保留进度。掌握程度独立。" Style="{StaticResource FocusComboBox}" /></StackPanel>
                <StackPanel Width="140" Margin="0,0,12,8"><TextBlock Text="掌握程度 · 自评" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{x:Static local:KnowledgeWorkspaceViewModel.MasteryLabels}" SelectedIndex="{Binding MasteryIndex}" Style="{StaticResource FocusComboBox}" /></StackPanel>
                <StackPanel Width="94" Margin="0,0,12,8"><TextBlock Text="已学进度 %" Style="{StaticResource MutedText}" /><TextBox Text="{Binding ProgressText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FocusTextBox}" /></StackPanel>
              </WrapPanel>
              <TextBlock Text="学习状态由你确认；时长、完成任务、自评掌握与验收彼此独立。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,12" />
              <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource FocusTextBlock}" Foreground="{DynamicResource Accent}" FontWeight="Medium" Margin="0,0,0,12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding StudySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <Expander Header="相关学习记录 · 含后代" Style="{StaticResource FocusExpander}"><ItemsControl ItemsSource="{Binding LinkedRecords}"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="StudyRecord_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxHeight="48" /><TextBlock Text="{Binding Context}" TextWrapping="Wrap" FontSize="11" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
              <Expander Header="相关任务" Style="{StaticResource FocusExpander}"><ItemsControl ItemsSource="{Binding LinkedTasks}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Click="StudyTask_Click" Style="{StaticResource QuietButton}" ToolTip="开始未完成任务" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
              <Expander Header="相关薄弱点" Style="{StaticResource FocusExpander}"><ItemsControl ItemsSource="{Binding LinkedWeakPoints}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding}" Click="StudyWeak_Click" Style="{StaticResource QuietButton}" ToolTip="查看、编辑或改变复习状态" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
              <TextBlock Text="说明 / 学习重点" Style="{StaticResource MutedText}" />
              <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FocusTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="130" VerticalScrollBarVisibility="Auto" />
              <Expander Header="目录结构 · 移动与排序" Style="{StaticResource FocusExpander}" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="父节点（仅当前科目）" Style="{StaticResource MutedText}" />
                  <ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding Parent}" DisplayMemberPath="Label" Style="{StaticResource FocusComboBox}" MaxDropDownHeight="260" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" />
                  <WrapPanel Margin="0,8,0,0"><ComboBox ItemsSource="{x:Static local:KnowledgeWorkspaceViewModel.KindLabels}" SelectedIndex="{Binding KindIndex}" Width="140" Style="{StaticResource FocusComboBox}" Margin="0,0,12,0" /><StackPanel Width="110"><TextBlock Text="排序 · 越小越靠前" Style="{StaticResource MutedText}" FontSize="11" /><TextBox Text="{Binding OrderText}" Style="{StaticResource FocusTextBox}" /></StackPanel></WrapPanel>
                  <TextBlock Text="{Binding NodeId,StringFormat=稳定 ID：{0}}" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Expander>
              <Expander Header="修改历史" Style="{StaticResource FocusExpander}"><TextBlock Text="{Binding HistoryText}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" /></Expander>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="把知识整理成自己的路径" Style="{StaticResource Subheading}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="选择一个章节查看进度；也可以先新增根章节，再逐步细分。" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding HasSelection,Converter={StaticResource Visible}}" IsEnabled="{Binding KnowledgeBusy,Converter={StaticResource Inverse}}"><TextBlock Text="单行 Enter 保存 · 多行 Ctrl+Enter 保存" Style="{StaticResource MutedText}" /><Button Content="保存修改" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" /><Button Content="{Binding ArchiveAction}" Click="Archive_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0" /></WrapPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Feedback}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" />
  </Grid>
</UserControl>
