     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="专注这一段" Style="{StaticResource Subheading}"/><Grid IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding TimerSubjects}" DisplayMemberPath="Name" SelectedItem="{Binding TimerSubject}" ToolTip="计时科目"/><ComboBox Grid.Column="2" ItemsSource="{Binding TimerChapters}" DisplayMemberPath="Name" SelectedItem="{Binding TimerChapter}" ToolTip="主要章节，可选"/></Grid><TextBox Text="{Binding TimerNote,UpdateSourceTrigger=PropertyChanged}" ToolTip="这一段学什么？备注可选" IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}"/><TextBlock Text="{Binding TimerStateText}" Style="{StaticResource MutedText}"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TimerText}" FontFamily="Cascadia Mono, Consolas" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/><WrapPanel><Button Content="开始" Style="{StaticResource Primary}" Command="{Binding StartCommand}" IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}"/><Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding TimerActive}"/><Button Content="结束" Command="{Binding FinishCommand}" IsEnabled="{Binding TimerActive}"/></WrapPanel></StackPanel></Grid></Border>
     <Border Background="{DynamicResource WarningSoft}" CornerRadius="12" Padding="16" Margin="0,0,0,16" Visibility="{Binding NeedsReview,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="待核对 · 未知时间未加入统计" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/><TextBlock Text="{Binding ReviewReason}" Margin="0,8"/><TextBlock Text="{Binding ReviewEvidence}" FontSize="12" Margin="0,0,0,8"/><WrapPanel><Button Content="仅保留已确认部分" Click="KeepConfirmed_Click"/><Button Content="核对后补记时长" Click="ReviewAdd_Click"/></WrapPanel></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="TodayLeft" Width="2*"/><ColumnDefinition x:Name="TodayGap" Width="16"/><ColumnDefinition x:Name="TodayRight" Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="每日详情 →" Click="TodayDetails_Click" Style="{StaticResource QuietButton}"/><TextBlock Text="今日记录" Style="{StaticResource Subheading}"/></DockPanel><TextBlock Text="最近 8 条预览 · 全部记录见学习记录明细" Style="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding TodayRecords}" ItemTemplate="{StaticResource StudySessionRow}"/><ContentControl Content="随时开始计时，或补录已经完成的学习。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding TodayRecords.Count,Converter={StaticResource Empty}}"/></StackPanel></Border>
      <Border x:Name="TodayReflection" Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="每日感想" Style="{StaticResource Subheading}"/><TextBlock Text="今天的收获，或明天的一小步。" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Reflection,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" ToolTip="今日感想，输入后自动保存"/><Button Content="保存感想" Click="SaveReflection_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><local:StudyChart Data="{Binding MiniTrend}" Mode="Sparkline" Height="44"/><TextBlock Text="近 7 日投入趋势 · 无连续打卡要求" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
     </Grid>
    </StackPanel>
    <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=1}">
