<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:YanJi.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YanJi.App.MainWindow" Icon="pack://application:,,,/Assets/Icons/YanJi.ico" Style="{StaticResource {x:Type Window}}" Title="研迹 YanJi" Width="1200" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" SizeChanged="Layout_Changed" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <local:DurationDisplayConverter x:Key="DurationDisplay" />
    <local:PageVisibilityConverter x:Key="PageVisibility" />
    <local:InverseBooleanConverter x:Key="Inverse" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:EmptyVisibilityConverter x:Key="Empty" />
    <local:HeatWidthConverter x:Key="HeatWidth" />
    <local:AverageMillisecondsConverter x:Key="AverageMilliseconds" />
    <Style TargetType="local:MetricCard">
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="local:MetricCard">
            <Border Style="{StaticResource SectionSurface}" Margin="0" Padding="16">
              <StackPanel>
                <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource Muted}" FontSize="12" Style="{StaticResource FocusTextBlock}" />
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="32" Margin="0,8,0,8">
                  <TextBlock Text="{TemplateBinding Value}" TextWrapping="NoWrap" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" ToolTip="{TemplateBinding Value}" Style="{StaticResource FocusTextBlock}" />
                </Viewbox>
                <TextBlock Text="{TemplateBinding Hint}" Foreground="{DynamicResource Muted}" FontSize="11" Style="{StaticResource FocusTextBlock}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="EmptyState">
      <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="20">
        <StackPanel>
          <TextBlock Text="还没有内容" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
          <TextBlock Text="{Binding}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Style="{StaticResource FocusTextBlock}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CalendarSessionRow">
      <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,0,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Color}" CornerRadius="2" />
          <StackPanel Grid.Column="1" Margin="12,0,8,0">
            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Chapter}" ToolTip="{Binding Chapter}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding DisplayScope}" Style="{StaticResource MutedText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ScopedDuration}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource FocusTextBlock}" />
            <Button Content="查看 →" Tag="{Binding}" Click="Detail_Click" Style="{StaticResource QuietButton}" Margin="0" MinHeight="30" Padding="6,2" AutomationProperties.Name="查看当天学习记录" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="StudyPartRow">
      <Border Background="{DynamicResource Soft}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right">
            <Button Content="排除片段" Tag="{Binding}" Click="ExcludePart_Click" Style="{StaticResource DangerButton}" x:Name="Exclude" />
            <Button Content="恢复片段" Tag="{Binding}" Click="RestorePart_Click" x:Name="Restore" Style="{StaticResource FocusButton}" />
          </WrapPanel>
          <StackPanel>
            <TextBlock Text="{Binding Date}" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Time}" Margin="0,4" FontSize="11" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource Accent}" ToolTip="{Binding Duration}" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Excluded}" Value="True">
          <Setter TargetName="Exclude" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Excluded}" Value="False">
          <Setter TargetName="Restore" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CompactStudySessionRow">
      <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Color}" CornerRadius="2" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0">
            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Chapter}" ToolTip="{Binding Chapter}" Style="{StaticResource StudioSubtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{Binding DisplayScope}" Style="{StaticResource StudioEyebrow}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
            <TextBlock Text="{Binding DisplayDuration}" FontSize="18" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" />
            <Button Content="查看详情" Click="Detail_Click" Tag="{Binding}" Style="{StaticResource QuietButton}" MinHeight="24" Padding="0" Margin="0" HorizontalAlignment="Right" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="⋯" Click="OpenActions_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="学习记录操作菜单" MinWidth="32" Margin="0" Grid.Column="3">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                <MenuItem Header="编辑记录" Tag="{Binding}" Click="EditRecord_Click" />
                <MenuItem Foreground="{DynamicResource Danger}" Header="删除记录…" Tag="{Binding}" Click="DeleteRecord_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="StudySessionRow">
      <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Color}" CornerRadius="2" />
          <StackPanel Grid.Column="2">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayDuration}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" ToolTip="{Binding ScopeLabel}" Margin="12,0,0,0" Style="{StaticResource FocusTextBlock}" />
              <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="15" Style="{StaticResource FocusTextBlock}" />
            </DockPanel>
            <TextBlock Text="{Binding DisplayScope}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4" ToolTip="{Binding Allocation}" Style="{StaticResource FocusTextBlock}" Visibility="Visible" />
            <TextBlock Text="{Binding Dates}" FontSize="11" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Chapter}" FontSize="12" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Note}" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.Note}" Margin="0,4,0,0" Style="{StaticResource FocusTextBlock}" />
            <WrapPanel Margin="-8,4,0,-4">
              <Button Content="查看" Tag="{Binding}" Click="Detail_Click" Style="{StaticResource QuietButton}" />
              <Button Content="编辑" Tag="{Binding}" Click="EditRecord_Click" Style="{StaticResource QuietButton}" />
              <Button Content="历史" Tag="{Binding}" Click="History_Click" Style="{StaticResource QuietButton}" />
              <Button Content="删除" Tag="{Binding}" Click="DeleteRecord_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Deleted}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="恢复" Tag="{Binding}" Click="RestoreRecord_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource FocusButton}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Deleted}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="AtelierSessionRow">
      <Border Background="{DynamicResource AtelierRow}" CornerRadius="12" Padding="16,12" Margin="0,0,0,8" BorderBrush="{DynamicResource AtelierEdge}" BorderThickness="0,0.5,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Color}" CornerRadius="2" />
          <StackPanel Grid.Column="1" Margin="14,0,12,0">
            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Chapter}" ToolTip="{Binding Chapter}" Style="{StaticResource AtelierMeta}" Margin="0,3,0,1" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBlock Text="{Binding DisplayScope}" Style="{StaticResource AtelierMeta}" FontSize="11" Margin="0" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
            <TextBlock Text="{Binding DisplayDuration}" FontSize="18" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" />
            <Button Content="查看详情" Click="Detail_Click" Tag="{Binding}" Style="{StaticResource AtelierInlineButton}" MinHeight="24" Padding="0" Margin="0" HorizontalAlignment="Right" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="⋯" Click="OpenActions_Click" Style="{StaticResource AtelierInlineButton}" AutomationProperties.Name="学习记录操作菜单" MinWidth="32" Margin="0" Grid.Column="3">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                <MenuItem Header="编辑记录" Tag="{Binding}" Click="EditRecord_Click" />
                <MenuItem Foreground="{DynamicResource Danger}" Header="删除记录…" Tag="{Binding}" Click="DeleteRecord_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="208" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Image x:Name="AtelierScenery" Grid.ColumnSpan="2" Source="Assets/Atmosphere/window-light-v1.png" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=0}"/>
    <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0" IsEnabled="{Binding DrawerOpen,Converter={StaticResource Inverse}}">
      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource NavigationBackground}"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Background" Value="{DynamicResource AtelierNavigation}"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel Margin="14,24,14,16">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
          <TextBlock Text="研迹" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" x:Name="BrandWord" Style="{StaticResource FocusTextBlock}" />
          <TextBlock Text="YANJI / 2028" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" x:Name="BrandHint" Style="{StaticResource FocusTextBlock}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="退出应用" Click="Exit_Click" x:Name="ExitButton" Style="{StaticResource QuietButton}" />
          <TextBlock Text="QUIET FOCUS 2.0" FontSize="11" Foreground="{DynamicResource Muted}" x:Name="VersionHint" Margin="10,8,0,0" Style="{StaticResource FocusTextBlock}" />
        </StackPanel>
        <ListBox x:Name="NavigationList" PreviewMouseLeftButtonUp="Navigation_Click" PreviewKeyDown="Navigation_KeyDown" SelectedIndex="{Binding NavigationIndex}" BorderThickness="0" Background="Transparent" SelectionChanged="Navigation_Changed" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,28,0,0">
          <ListBoxItem ToolTip="今日">
            <StackPanel Orientation="Horizontal">
              <local:FocusIcon Kind="timer" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Text="今日" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem ToolTip="学习进度">
            <StackPanel Orientation="Horizontal">
              <local:FocusIcon Kind="plan" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Text="学习进度" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem ToolTip="学习数据">
            <StackPanel Orientation="Horizontal">
              <local:FocusIcon Kind="stats" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Text="学习数据" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem ToolTip="更多功能">
            <StackPanel Orientation="Horizontal">
              <local:FocusIcon Kind="settings" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Text="更多功能" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" IsEnabled="{Binding DrawerOpen,Converter={StaticResource Inverse}}">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,8">
        <Grid IsEnabled="{Binding Busy,Converter={StaticResource Inverse}}">
          <StackPanel x:Name="AtelierToday" Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=0}">
            <Grid x:Name="AtelierHeader" Margin="0,2,0,26">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel x:Name="AtelierHeading">
                <TextBlock x:Name="StudioDate" Style="{StaticResource StudioEyebrow}" FontSize="12" Margin="0,0,0,2"/>
                <TextBlock x:Name="StudioTodayTitle" Text="把这一刻，留给学习。" Style="{StaticResource AtelierTitle}"/>
                <DockPanel><Button DockPanel.Dock="Right" Content="背景氛围" Style="{StaticResource AtelierAuxiliaryButton}" Click="OpenActions_Click" Margin="12,0,0,0" ToolTip="调整今日背景强度 · 当前窗口有效">
                  <Button.ContextMenu><ContextMenu><MenuItem Header="自然光" Tag="1" Click="Atmosphere_Click"/><MenuItem Header="柔和光" Tag="0.45" Click="Atmosphere_Click"/><MenuItem Header="纯色" Tag="0" Click="Atmosphere_Click"/></ContextMenu></Button.ContextMenu>
                </Button><TextBlock Text="安静地专注，持续地向前。" FontFamily="SimSun, Microsoft YaHei UI" FontSize="16" Foreground="{DynamicResource Muted}" Margin="0,0,0,2"/></DockPanel>
              </StackPanel>
              <Border x:Name="TodayReflection" Grid.Column="1" Style="{StaticResource AtelierSummaryPlane}" Width="308" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,8,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="29"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource AtelierMetricButton}" Click="Metric_Click" Tag="day" ToolTip="{Binding TodayTotal}"><StackPanel><TextBlock Text="今日投入" Style="{StaticResource AtelierMeta}" FontSize="11" Margin="0,0,0,8"/><Viewbox Height="29" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><local:NaturalDuration Milliseconds="{Binding TodayDurationMs}" Style="{StaticResource DurationNumber}" FontSize="24" Foreground="{DynamicResource Accent}" TextWrapping="NoWrap"/></Viewbox></StackPanel></Button>
                  <Border Grid.Column="1" Width="0.75" Background="{DynamicResource AtelierEdge}" Margin="0,7"/>
                  <Button Grid.Column="2" Style="{StaticResource AtelierMetricButton}" Click="Metric_Click" Tag="week" ToolTip="{Binding WeekTotal}"><StackPanel><TextBlock Text="本周投入" Style="{StaticResource AtelierMeta}" FontSize="11" Margin="0,0,0,8"/><Viewbox Height="29" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><local:NaturalDuration Milliseconds="{Binding WeekDurationMs}" Style="{StaticResource DurationNumber}" FontSize="24" TextWrapping="NoWrap"/></Viewbox></StackPanel></Button>
                </Grid>
              </Border>
            </Grid>
            <Border Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="16" Margin="0,0,0,20" Visibility="{Binding NeedsReview,Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <TextBlock Text="待核对 · 未知时间未加入统计" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Style="{StaticResource FocusTextBlock}" />
                <TextBlock Text="{Binding ReviewReason}" Margin="0,8" Style="{StaticResource FocusTextBlock}" />
                <TextBlock Text="{Binding ReviewEvidence}" FontSize="12" Margin="0,0,0,8" Style="{StaticResource FocusTextBlock}" />
                <WrapPanel>
                  <Button Content="仅保留已确认部分" Click="KeepConfirmed_Click" Style="{StaticResource FocusButton}" />
                  <Button Content="核对后补记时长" Click="ReviewAdd_Click" Style="{StaticResource FocusButton}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Grid x:Name="AtelierFocusWidth" Margin="0,0,100,20">
              <Border Background="#12314537" CornerRadius="22" Margin="1,4,-1,-4" IsHitTestVisible="False"/>
              <Border x:Name="AtelierFocusPlane" Style="{StaticResource AtelierPlane}">
                <StackPanel>
                  <Grid x:Name="TimerFields" IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="科目" Style="{StaticResource MutedText}" Margin="0"/><ComboBox ItemsSource="{Binding TimerSubjects}" DisplayMemberPath="Name" SelectedItem="{Binding TimerSubject}" Style="{StaticResource AtelierField}" AutomationProperties.Name="计时科目" HorizontalContentAlignment="Stretch"/></StackPanel>
                    <StackPanel x:Name="TimerChapterField" Grid.Column="2"><DockPanel><Button Content="章节目录" DockPanel.Dock="Right" Click="ManageChapters_Click" Style="{StaticResource AtelierInlineButton}" Margin="6,-4,-8,0"/><TextBlock Text="章节 · 可选" Style="{StaticResource MutedText}" Margin="0"/></DockPanel><ComboBox ItemsSource="{Binding TimerChapters}" DisplayMemberPath="Name" SelectedItem="{Binding TimerChapter}" Style="{StaticResource AtelierField}" AutomationProperties.Name="主要章节，可选" HorizontalContentAlignment="Stretch" ToolTip="{Binding TimerChapter.Name}"/></StackPanel>
                  </Grid>
                  <Grid x:Name="AtelierClockGrid" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TodayLeft"/><ColumnDefinition x:Name="TodayGap" Width="20"/><ColumnDefinition x:Name="TodayRight" Width="210"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><Viewbox x:Name="AtelierClockBox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="120"><TextBlock x:Name="TimerDigits" Text="{Binding TimerText}" FontFamily="Georgia, Cambria, Segoe UI" FontSize="104" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Ink}" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="{Binding FocusSubjectLabel}" Style="{StaticResource AtelierMeta}" Margin="2,0,0,0"/><TextBlock Text="{Binding TimerStateText}" Margin="2,6,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StudioEyebrow}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TimerActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding BreakActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                    <StackPanel x:Name="AtelierControls" Grid.Column="2" VerticalAlignment="Center">
                      <Button x:Name="AtelierStart" Content="{Binding FocusStartLabel}" Style="{StaticResource AtelierPrimary}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartFocus}" Visibility="{Binding CanStartFocus,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="FocusStart"/>
                      <Button x:Name="AtelierPause" Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPauseFocus}" AutomationProperties.AutomationId="FocusPause"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AtelierPrimary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TimerActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding BreakActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                      <Button Content="结束并保存" Command="{Binding FinishCommand}" IsEnabled="{Binding TimerActive}" Visibility="{Binding TimerActive,Converter={StaticResource BoolVisibility}}" Style="{StaticResource StudioSecondary}" Margin="0,10,0,0"/>
                      <Button Content="＋ 手动补录" Style="{StaticResource AtelierManualButton}" Click="QuickAdd_Click"/>
                    </StackPanel>
                  </Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AtelierSegment}" CornerRadius="10" Padding="3" HorizontalAlignment="Left" IsEnabled="{Binding CanStartFocus}"><StackPanel Orientation="Horizontal">
                      <RadioButton Content="自由计时" GroupName="AtelierMode" Style="{StaticResource AtelierMode}" IsChecked="{Binding FocusModeIndex,Converter={StaticResource AtelierModeChecked},ConverterParameter=0}"/>
                      <RadioButton Content="番茄钟" GroupName="AtelierMode" Style="{StaticResource AtelierMode}" IsChecked="{Binding FocusModeIndex,Converter={StaticResource AtelierModeChecked},ConverterParameter=2}"/>
                      <RadioButton Content="倒计时" GroupName="AtelierMode" Style="{StaticResource AtelierMode}" IsChecked="{Binding FocusModeIndex,Converter={StaticResource AtelierModeChecked},ConverterParameter=1}"/>
                    </StackPanel></Border>
                    <Button Grid.Column="1" Content="悬浮计时" Click="ShowMini_Click" Style="{StaticResource AtelierAuxiliaryButton}" Margin="12,0,0,0" ToolTip="Ctrl+M · 与主窗口同步"/>
                  </Grid>
                  <ComboBox x:Name="FocusModeSelector" Visibility="Collapsed" SelectedIndex="{Binding FocusModeIndex}"><ComboBoxItem Content="自由计时"/><ComboBoxItem Content="倒计时"/><ComboBoxItem Content="番茄钟"/></ComboBox>
                  <WrapPanel IsEnabled="{Binding CanStartFocus}" Visibility="{Binding ConfiguredTimed,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"><TextBlock Text="专注" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding FocusMinutes,UpdateSourceTrigger=PropertyChanged}" Width="72" Style="{StaticResource FocusTextBox}" Padding="8,4" MinHeight="32" Margin="0" AutomationProperties.Name="专注分钟"/><TextBlock Text="分钟" Margin="6,0,12,0" VerticalAlignment="Center" Style="{StaticResource MutedText}"/><TextBox Text="{Binding BreakMinutes,UpdateSourceTrigger=PropertyChanged}" Width="62" Style="{StaticResource FocusTextBox}" Padding="8,4" Margin="0" MinHeight="32" Visibility="{Binding ConfiguredPomodoro,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="番茄休息分钟"/><TextBlock Text="分钟休息" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding ConfiguredPomodoro,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
                  <TextBlock Text="{Binding FocusRemainingText}" Visibility="{Binding ConfiguredTimed,Converter={StaticResource BoolVisibility}}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                  <ProgressBar Visibility="{Binding HasFocusGoal,Converter={StaticResource BoolVisibility}}" Value="{Binding FocusProgress}" Maximum="100" Height="3" Margin="0,8,0,0" AutomationProperties.Name="目标有效时长进度"/>
                  <WrapPanel><Button Content="跳过休息" Command="{Binding SkipBreakCommand}" Visibility="{Binding BreakActive,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}"/><Button Content="任务操作 ⋯" Visibility="{Binding HasLinkedTask,Converter={StaticResource BoolVisibility}}" Click="OpenActions_Click" Style="{StaticResource QuietButton}"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="标记任务完成" Command="{Binding CompleteFocusTaskCommand}" IsEnabled="{Binding CanCompleteLinkedTask}"/><MenuItem Header="解除任务关联" Command="{Binding ClearFocusTaskCommand}" IsEnabled="{Binding CanStartFocus}"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
