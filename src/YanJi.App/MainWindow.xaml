      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="‹" Command="{Binding PreviousMonthCommand}" ToolTip="上月"/><Button Content="›" Command="{Binding NextMonthCommand}" ToolTip="下月"/></WrapPanel><TextBlock Text="{Binding MonthLabel}" Style="{StaticResource Subheading}"/></DockPanel><UniformGrid Columns="7" Margin="0,0,0,6"><TextBlock Text="一" TextAlignment="Center"/><TextBlock Text="二" TextAlignment="Center"/><TextBlock Text="三" TextAlignment="Center"/><TextBlock Text="四" TextAlignment="Center"/><TextBlock Text="五" TextAlignment="Center"/><TextBlock Text="六" TextAlignment="Center"/><TextBlock Text="日" TextAlignment="Center"/></UniformGrid>
       <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.SelectDayCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Description}" Height="50" MinHeight="0" Padding="2" FontSize="10" Margin="2"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding InMonth}" Value="False"><Setter Property="Opacity" Value="0.35"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="待核对"><Setter Property="BorderBrush" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="无记录不代表休息 · 点击日期查看当天贡献" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
      <StackPanel Grid.Column="2" x:Name="CalendarDetail"><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="记录明细 →" Click="DayRecords_Click" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding SelectedDate,StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource Subheading}"/></DockPanel><WrapPanel><TextBlock Text="{Binding DayTotal}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,12,8"/><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding DayState}"/></Border><Button Content="切换休息日标记" Click="RestDay_Click" Style="{StaticResource QuietButton}"/></WrapPanel><TextBlock Text="学习时间轴 · 仅展示真实时间区间" Style="{StaticResource MutedText}"/><local:StudyChart Data="{Binding TimelinePlot}" Mode="Timeline" PointInvoked="Timeline_Drill"/><TextBlock Text="纯时长补录 · 没有假定时间位置" Style="{StaticResource MutedText}" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding DurationRecords}" ItemTemplate="{StaticResource StudySessionRow}"/>
