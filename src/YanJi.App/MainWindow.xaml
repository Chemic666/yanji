<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:YanJi.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YanJi.App.MainWindow" Icon="pack://application:,,,/Assets/Icons/YanJi.ico" Style="{StaticResource {x:Type Window}}" Title="研迹 YanJi · RC-Calendar.1 · 2028 备考" Width="1200" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" SizeChanged="Layout_Changed" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <local:DurationDisplayConverter x:Key="DurationDisplay" />
    <local:PageVisibilityConverter x:Key="PageVisibility" />
    <local:InverseBooleanConverter x:Key="Inverse" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:EmptyVisibilityConverter x:Key="Empty" />
    <local:HeatWidthConverter x:Key="HeatWidth" />
    <local:AverageMillisecondsConverter x:Key="AverageMilliseconds" />
    <Style TargetType="local:MetricCard">
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="local:MetricCard">
            <Border Style="{StaticResource SectionSurface}" Margin="0" Padding="16">
              <StackPanel>
                <TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource Muted}" FontSize="12" Style="{StaticResource FocusTextBlock}" />
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="32" Margin="0,8,0,8">
                  <TextBlock Text="{TemplateBinding Value}" TextWrapping="NoWrap" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" ToolTip="{TemplateBinding Value}" Style="{StaticResource FocusTextBlock}" />
                </Viewbox>
                <TextBlock Text="{TemplateBinding Hint}" Foreground="{DynamicResource Muted}" FontSize="11" Style="{StaticResource FocusTextBlock}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="EmptyState">
      <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="20">
        <StackPanel>
          <TextBlock Text="还没有内容" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
          <TextBlock Text="{Binding}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Style="{StaticResource FocusTextBlock}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CalendarSessionRow">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,0,0,2">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="{Binding Color}" CornerRadius="2"/>
          <StackPanel Grid.Column="1" Margin="12,0,8,0">
            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}"/>
            <TextBlock Text="{Binding Chapter}" ToolTip="{Binding Chapter}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding DisplayScope}" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding ScopedDuration}" FontWeight="SemiBold" HorizontalAlignment="Right" Style="{StaticResource FocusTextBlock}"/>
            <Button Content="查看 →" Tag="{Binding}" Click="Detail_Click" Style="{StaticResource QuietButton}" Margin="0" MinHeight="30" Padding="6,2" AutomationProperties.Name="查看当天学习记录"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="StudyPartRow">
      <Border Background="{DynamicResource Soft}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right">
            <Button Content="排除片段" Tag="{Binding}" Click="ExcludePart_Click" Style="{StaticResource DangerButton}" x:Name="Exclude" />
            <Button Content="恢复片段" Tag="{Binding}" Click="RestorePart_Click" x:Name="Restore" Style="{StaticResource FocusButton}" />
          </WrapPanel>
          <StackPanel>
            <TextBlock Text="{Binding Date}" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Time}" Margin="0,4" FontSize="11" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Duration}" Foreground="{DynamicResource Accent}" ToolTip="{Binding Duration}" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Excluded}" Value="True">
          <Setter TargetName="Exclude" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Excluded}" Value="False">
          <Setter TargetName="Restore" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CompactStudySessionRow">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,4">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayDuration}" ToolTip="{Binding ScopeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" />
          </DockPanel>
          <TextBlock Text="{Binding DisplayScope}" Style="{StaticResource MetaText}" ToolTip="{Binding ScopeLabel}" Margin="0,4,0,0" />

          <TextBlock Text="{Binding Note}" Style="{StaticResource MetaText}" MaxHeight="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.Note}" />
          <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="记录操作 ⋯" Click="OpenActions_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="学习记录操作菜单">
              <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                <MenuItem Header="编辑记录" Tag="{Binding}" Click="EditRecord_Click" />
                <MenuItem Foreground="{DynamicResource Danger}" Header="删除记录…" Tag="{Binding}" Click="DeleteRecord_Click" />
              </ContextMenu></Button.ContextMenu>
            </Button>
            <Button Content="查看详情" Tag="{Binding}" Click="Detail_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
          </DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="StudySessionRow">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Color}" CornerRadius="2" />
          <StackPanel Grid.Column="2">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayDuration}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" ToolTip="{Binding ScopeLabel}" Margin="12,0,0,0" Style="{StaticResource FocusTextBlock}" />
              <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="15" Style="{StaticResource FocusTextBlock}" />
            </DockPanel>
            <TextBlock Text="{Binding DisplayScope}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4" ToolTip="{Binding Allocation}" Style="{StaticResource FocusTextBlock}" Visibility="Visible" />
            <TextBlock Text="{Binding Dates}" FontSize="11" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Chapter}" FontSize="12" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
            <TextBlock Text="{Binding Note}" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.Note}" Margin="0,4,0,0" Style="{StaticResource FocusTextBlock}" />
            <WrapPanel Margin="-8,4,0,-4">
              <Button Content="查看" Tag="{Binding}" Click="Detail_Click" Style="{StaticResource QuietButton}" />
              <Button Content="编辑" Tag="{Binding}" Click="EditRecord_Click" Style="{StaticResource QuietButton}" />
              <Button Content="历史" Tag="{Binding}" Click="History_Click" Style="{StaticResource QuietButton}" />
              <Button Content="删除" Tag="{Binding}" Click="DeleteRecord_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Deleted}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="恢复" Tag="{Binding}" Click="RestoreRecord_Click">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource FocusButton}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Deleted}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="NavColumn" Width="208" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource NavigationBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0" IsEnabled="{Binding DrawerOpen,Converter={StaticResource Inverse}}">
      <DockPanel Margin="14,24,14,16">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24">
          <TextBlock Text="研迹" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" x:Name="BrandWord" Style="{StaticResource FocusTextBlock}" />
          <TextBlock Text="YANJI / 2028" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" x:Name="BrandHint" Style="{StaticResource FocusTextBlock}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="退出应用" Click="Exit_Click" x:Name="ExitButton" Style="{StaticResource QuietButton}" />
          <TextBlock Text="V0.4 RC-Calendar.1" FontSize="11" Foreground="{DynamicResource Muted}" x:Name="VersionHint" Margin="10,8,0,0" Style="{StaticResource FocusTextBlock}" />
        </StackPanel>
        <ListBox x:Name="NavigationList" PreviewMouseLeftButtonUp="Navigation_Click" PreviewKeyDown="Navigation_KeyDown" SelectedIndex="{Binding NavigationIndex}" BorderThickness="0" Background="Transparent" SelectionChanged="Navigation_Changed" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBoxItem ToolTip="今日"><StackPanel Orientation="Horizontal"><local:FocusIcon Kind="timer" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="今日" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" /></StackPanel></ListBoxItem><ListBoxItem ToolTip="学习进度"><StackPanel Orientation="Horizontal"><local:FocusIcon Kind="plan" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="学习进度" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" /></StackPanel></ListBoxItem><ListBoxItem ToolTip="学习数据"><StackPanel Orientation="Horizontal"><local:FocusIcon Kind="stats" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="学习数据" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" /></StackPanel></ListBoxItem><ListBoxItem ToolTip="更多功能"><StackPanel Orientation="Horizontal"><local:FocusIcon Kind="settings" Width="20" Height="20" Margin="0,0,12,0" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="更多功能" Tag="NavLabel" Style="{StaticResource FocusTextBlock}" /></StackPanel></ListBoxItem></ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" IsEnabled="{Binding DrawerOpen,Converter={StaticResource Inverse}}">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,8">
        <Grid IsEnabled="{Binding Busy,Converter={StaticResource Inverse}}">
          <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=0}">
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="＋ 快速补录" Style="{StaticResource FocusButton}" Click="QuickAdd_Click" />
              <StackPanel>
                <TextBlock Text="今日" Style="{StaticResource Heading}" />
                <TextBlock Text="专注当下，也看得见自己的积累。" Style="{StaticResource MutedText}" />
              </StackPanel>
            </DockPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource QuietButton}" Click="Metric_Click" Tag="day" HorizontalContentAlignment="Left" Padding="0" ToolTip="{Binding TodayTotal}">
                <StackPanel>
                  <TextBlock Text="今日投入" Style="{StaticResource MutedText}" />
                  <local:NaturalDuration Milliseconds="{Binding TodayDurationMs}" Style="{StaticResource DurationNumber}" FontSize="28" Foreground="{DynamicResource Accent}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="Metric_Click" Tag="week" HorizontalContentAlignment="Left" ToolTip="{Binding WeekTotal}">
                <StackPanel>
                  <TextBlock Text="本周 · 周一开始" Style="{StaticResource MutedText}" />
                  <local:NaturalDuration Milliseconds="{Binding WeekDurationMs}" Style="{StaticResource DurationNumber}" FontSize="20" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="Metric_Click" Tag="month" HorizontalContentAlignment="Left" ToolTip="{Binding MonthTotal}">
                <StackPanel>
                  <TextBlock Text="本月累计" Style="{StaticResource MutedText}" />
                  <local:NaturalDuration Milliseconds="{Binding MonthDurationMs}" Style="{StaticResource DurationNumber}" FontSize="20" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="本段计时中 · 汇总在暂停或结束后更新" Visibility="{Binding TimerRunning,Converter={StaticResource BoolVisibility}}" Style="{StaticResource MutedText}" />
            <Border Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="16" Margin="0,0,0,20" Visibility="{Binding NeedsReview,Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <TextBlock Text="待核对 · 未知时间未加入统计" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Style="{StaticResource FocusTextBlock}" />
                <TextBlock Text="{Binding ReviewReason}" Margin="0,8" Style="{StaticResource FocusTextBlock}" />
                <TextBlock Text="{Binding ReviewEvidence}" FontSize="12" Margin="0,0,0,8" Style="{StaticResource FocusTextBlock}" />
                <WrapPanel>
                  <Button Content="仅保留已确认部分" Click="KeepConfirmed_Click" Style="{StaticResource FocusButton}" />
                  <Button Content="核对后补记时长" Click="ReviewAdd_Click" Style="{StaticResource FocusButton}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TodayLeft" Width="1.1*" />
                <ColumnDefinition x:Name="TodayGap" Width="20" />
                <ColumnDefinition x:Name="TodayRight" Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <Border Style="{StaticResource SectionSurface}">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding TimerStateText}" Style="{StaticResource MutedText}" MaxWidth="200" />
                      <Button DockPanel.Dock="Right" Content="迷你窗 ↗" Click="ShowMini_Click" Style="{StaticResource QuietButton}" ToolTip="Ctrl+M，迷你窗与主窗共享同一计时" Margin="4,0" Padding="4,0" MinHeight="24" />
                      <TextBlock Text="专注这一段" Style="{StaticResource Subheading}" />
                    </DockPanel>
                    <Grid x:Name="TimerFields" Visibility="{Binding FocusSetupVisible,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="科目" Style="{StaticResource MutedText}" />
                        <ComboBox ItemsSource="{Binding TimerSubjects}" DisplayMemberPath="Name" SelectedItem="{Binding TimerSubject}" ToolTip="计时科目" AutomationProperties.Name="计时科目" Style="{StaticResource FocusComboBox}" HorizontalContentAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel x:Name="TimerChapterField" Grid.Column="2">
                        <DockPanel><Button DockPanel.Dock="Right" Content="管理章节" Click="ManageChapters_Click" Style="{StaticResource QuietButton}" Padding="0" Margin="8,0,0,0" MinHeight="0" Height="20"/><TextBlock Text="主要章节 · 可选" Style="{StaticResource MutedText}" /></DockPanel>
<ComboBox ItemsSource="{Binding TimerChapters}" DisplayMemberPath="Name" SelectedItem="{Binding TimerChapter}" ToolTip="主要章节，可选" AutomationProperties.Name="主要章节，可选" Style="{StaticResource FocusComboBox}" HorizontalContentAlignment="Stretch" />
                      </StackPanel>
                    </Grid><TextBlock Visibility="{Binding HasLinkedTask,Converter={StaticResource BoolVisibility}}" Text="{Binding FocusTaskLabel}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding FocusTaskLabel}" Style="{StaticResource FocusTextBlock}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding FocusSubjectLabel}" Style="{StaticResource MutedText}" Margin="0,2,0,6" />
                    <TextBlock x:Name="TimerDigits" Text="{Binding TimerText}" FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" FontSize="56" Foreground="{DynamicResource Accent}" Margin="0,12,0,8" Style="{StaticResource FocusTextBlock}" />
                    <TextBlock Visibility="{Binding ConfiguredTimed,Converter={StaticResource BoolVisibility}}" Text="{Binding FocusRemainingText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ProgressBar Visibility="{Binding HasFocusGoal,Converter={StaticResource BoolVisibility}}" Value="{Binding FocusProgress}" Maximum="100" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Soft}" Margin="0,0,0,8" AutomationProperties.Name="目标有效时长进度" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="{Binding FocusStartLabel}" Style="{StaticResource Primary}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartFocus}" MinWidth="100" AutomationProperties.AutomationId="FocusStart" />
                      <Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPauseFocus}" Style="{StaticResource FocusButton}" AutomationProperties.AutomationId="FocusPause" />
                      <Button Content="结束" Command="{Binding FinishCommand}" IsEnabled="{Binding TimerActive}" Style="{StaticResource FocusButton}" />

                    </WrapPanel>
                    <Expander Header="{Binding FocusOptionsLabel}" Style="{StaticResource FocusExpander}" Visibility="{Binding FocusSetupVisible,Converter={StaticResource BoolVisibility}}"><WrapPanel IsEnabled="{Binding CanStartFocus}" Visibility="{Binding FocusSetupVisible,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
                      <ComboBox x:Name="FocusModeSelector" SelectedIndex="{Binding FocusModeIndex}" Width="130" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="专注模式">
                        <ComboBoxItem Content="自由计时" /><ComboBoxItem Content="倒计时" /><ComboBoxItem Content="番茄钟" />
                      </ComboBox>
                      <TextBox Text="{Binding FocusMinutes,UpdateSourceTrigger=PropertyChanged}" Width="86" Padding="6,2" HorizontalContentAlignment="Center" Visibility="{Binding ConfiguredTimed,Converter={StaticResource BoolVisibility}}" Style="{StaticResource FocusTextBox}" AutomationProperties.Name="专注分钟" ToolTip="限时模式专注 1～720 分钟；自由计时忽略此项" />
                      <TextBlock Text="分" Visibility="{Binding ConfiguredTimed,Converter={StaticResource BoolVisibility}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0" />
                      <TextBox Text="{Binding BreakMinutes,UpdateSourceTrigger=PropertyChanged}" Width="68" Padding="6,2" HorizontalContentAlignment="Center" Visibility="{Binding ConfiguredPomodoro,Converter={StaticResource BoolVisibility}}" Style="{StaticResource FocusTextBox}" AutomationProperties.Name="番茄休息分钟" ToolTip="番茄结束后休息 1～60 分钟，不计入学习" />
                      <TextBlock Text="分休息" Visibility="{Binding ConfiguredPomodoro,Converter={StaticResource BoolVisibility}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </WrapPanel></Expander><WrapPanel>
                      <Button Content="跳过休息" Command="{Binding SkipBreakCommand}" Visibility="{Binding BreakActive,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}" />
                      <Button Content="任务操作 ⋯" Visibility="{Binding HasLinkedTask,Converter={StaticResource BoolVisibility}}" Click="OpenActions_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="关联任务操作菜单">
                        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="标记任务完成" Command="{Binding CompleteFocusTaskCommand}" IsEnabled="{Binding CanCompleteLinkedTask}" />
                          <MenuItem Header="解除任务关联" Command="{Binding ClearFocusTaskCommand}" IsEnabled="{Binding CanStartFocus}" />
                        </ContextMenu></Button.ContextMenu>
                      </Button>
                    </WrapPanel>

                    <Expander Visibility="{Binding FocusSetupVisible,Converter={StaticResource BoolVisibility}}" Header="添加这一段的备注" Style="{StaticResource FocusExpander}">
                      <TextBox Text="{Binding TimerNote,UpdateSourceTrigger=PropertyChanged}" ToolTip="这一段学什么？备注可选" AutomationProperties.Name="这一段学什么？备注可选" IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}" Style="{StaticResource FocusTextBox}" />
                    </Expander>

                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionSurface}" Visibility="{Binding HasCompletedStudy,Converter={StaticResource BoolVisibility}}">
                  <StackPanel><TextBlock Text="本次已保存 · 可以直接离开" Style="{StaticResource Subheading}" />
                    <TextBlock Text="可选补充备注、薄弱点或学习进度，不会自动判断掌握。" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    <WrapPanel><Button Content="补充本次学习" Click="CompleteStudy_Click" Style="{StaticResource QuietButton}" /><Button Content="跳过" Command="{Binding DismissCompletedStudyCommand}" Style="{StaticResource QuietButton}" /></WrapPanel>
                  </StackPanel></Border>
                <Expander Header="每日感想 · 可选" Style="{StaticResource FocusExpander}"><Border Style="{StaticResource SectionSurface}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="保存感想" Click="SaveReflection_Click" Style="{StaticResource QuietButton}" />
                      <TextBlock Text="每日感想" Style="{StaticResource Subheading}" />
                    </DockPanel>
                    <TextBox Text="{Binding Reflection,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalScrollBarVisibility="Auto" ToolTip="今日感想，输入后自动保存" AutomationProperties.Name="今日感想，输入后自动保存" Margin="0" Style="{StaticResource FocusTextBox}" />
                    <TextBlock Text="今天的收获，或明天的一小步。输入后自动保存。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                  </StackPanel>
                </Border></Expander>
              </StackPanel>
              <StackPanel x:Name="TodayReflection" Grid.Column="2">

                <Border Style="{StaticResource DenseSurface}">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="学习记录" Click="TodayRecords_Click" Style="{StaticResource QuietButton}" />
                      <TextBlock Text="今日记录" Style="{StaticResource Subheading}" />
                    </DockPanel>
                    <ListBox x:Name="TodayRecordList" ItemsSource="{Binding TodayRecords}" ItemTemplate="{StaticResource CompactStudySessionRow}" ItemContainerStyle="{StaticResource RecordItem}" MaxHeight="330" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    <ContentControl Content="随时开始计时，或补录已经完成的学习。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding TodayRecords.Count,Converter={StaticResource Empty}}" />
                    <WrapPanel Margin="0,4,0,0">
                      <Button Content="每日详情 →" Click="TodayDetails_Click" Style="{StaticResource QuietButton}" />
                      <Button Content="区间补录" Click="KnownInterval_Click" Style="{StaticResource QuietButton}" />
                    </WrapPanel>
                  </StackPanel>
                </Border><Expander Header="学习任务 · 一键开始" Style="{StaticResource FocusExpander}"><Border Style="{StaticResource DenseSurface}">
                  <StackPanel>
                    <DockPanel><Button Content="新增任务" DockPanel.Dock="Right" Click="AddTask_Click" Style="{StaticResource QuietButton}" /><TextBlock Text="今日待办 · 直接开始" Style="{StaticResource Subheading}" /></DockPanel>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding TodayTasks}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <DockPanel Margin="0,6">
                          <Button DockPanel.Dock="Right" Content="开始 →" Command="{Binding DataContext.StartTaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding DataContext.CanStartFocus,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource QuietButton}" />
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource FocusTextBlock}" ToolTip="{Binding Title}" />
                        </DockPanel>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                    <ContentControl Content="选一件小任务，从这里开始。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding TodayTasks.Count,Converter={StaticResource Empty}}" />
                  </StackPanel>
                </Border></Expander>
                <Expander Header="最近学习与七日趋势" Style="{StaticResource FocusExpander}"><Border Style="{StaticResource DenseSurface}">
                  <StackPanel>
                    <TextBlock Text="最近学习 · 继续一段新学习" Style="{StaticResource Subheading}" />
