<Window x:Class="YanJi.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YanJi.App" Style="{StaticResource {x:Type Window}}" Title="研迹 YanJi · 2028 备考" Width="1200" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <local:StateLabelConverter x:Key="StateLabel"/><local:PageVisibilityConverter x:Key="PageVisibility"/><local:InverseBooleanConverter x:Key="Inverse"/><BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <DataTemplate x:Key="Records">
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock FontWeight="SemiBold"><Run Text="{Binding Subject,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Duration,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Chapter}" Foreground="{StaticResource Muted}" Margin="0,4"/><TextBlock Text="{Binding Allocation}" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Note}" Margin="0,4,8,0"/></StackPanel>
     <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="详情 / 修正" Click="EditRecord_Click" Tag="{Binding}"/><Button Content="历史" Click="History_Click" Tag="{Binding}"/></WrapPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,32,16,20">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,36"><TextBlock Text="研迹" FontSize="32" FontWeight="Bold"/><TextBlock Text="YANJI · 2028" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,16,0,0"><TextBlock Text="每一段学习，都有迹可循" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/><Button Content="退出应用" Click="Exit_Click"/><TextBlock Text="V0.1 · 本地离线" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
    <ListBox SelectedIndex="{Binding Page}" BorderThickness="0" Background="Transparent" FontSize="15" SelectionChanged="Navigation_Changed">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#E7F4F5"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#F0F5F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBoxItem Content="今日学习"/><ListBoxItem Content="备考历程"/><ListBoxItem Content="计划与进度"/><ListBoxItem Content="薄弱点"/><ListBoxItem Content="统计与复盘"/><ListBoxItem Content="设置与数据"/>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,8">
    <Grid IsEnabled="{Binding Busy,Converter={StaticResource Inverse}}">
     <!-- Today: one natural reading column remains usable at 900x600. -->
     <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=0}">
      <TextBlock Text="今日学习" Style="{StaticResource Heading}"/><TextBlock Text="把注意力留给学习，记录交给研迹。" Style="{StaticResource MutedText}"/>
      <UniformGrid Columns="3" Margin="0,8,0,8"><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="今天" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding TodayTotal}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="本周 · 周一起" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding WeekTotal}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本月" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding MonthTotal}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="专注这一段" Style="{StaticResource Subheading}"/>
       <StackPanel IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="科目"/><ComboBox ItemsSource="{Binding TimerSubjects}" DisplayMemberPath="Name" SelectedItem="{Binding TimerSubject}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="主要章节（可选）"/><ComboBox ItemsSource="{Binding TimerChapters}" DisplayMemberPath="Name" SelectedItem="{Binding TimerChapter}"/></StackPanel></Grid><TextBox Text="{Binding TimerNote,UpdateSourceTrigger=PropertyChanged}" ToolTip="本次学习备注（可选）"/></StackPanel>
       <TextBlock Text="{Binding TimerText}" FontFamily="Cascadia Mono, Consolas" FontSize="48" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="{Binding TimerStateText}" Style="{StaticResource MutedText}"/>
       <WrapPanel><Button Content="开始学习" Style="{StaticResource Primary}" Command="{Binding StartCommand}" IsEnabled="{Binding TimerActive,Converter={StaticResource Inverse}}"/><Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding TimerActive}"/><Button Content="结束并保存" Command="{Binding FinishCommand}" IsEnabled="{Binding TimerActive}"/></WrapPanel>
       <Border Background="#FFF5DE" CornerRadius="8" Padding="16" Margin="0,8,0,0" Visibility="{Binding NeedsReview,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="需要核对未知时间" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewReason}" Margin="0,8"/><TextBlock Text="{Binding ReviewEvidence}" Margin="0,0,0,12"/><WrapPanel><Button Content="仅保留已确认部分" Click="KeepConfirmed_Click"/><Button Content="核对后补记时长" Click="ReviewAdd_Click"/></WrapPanel><TextBlock Text="核对后保持暂停，不会自动继续计时。" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="快速补录" Style="{StaticResource Subheading}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="日期 *"/><DatePicker SelectedDate="{Binding ManualDate}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="科目 *"/><ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name" SelectedItem="{Binding ManualSubject}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="时长（分钟）*"/><TextBox Text="{Binding ManualMinutes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
       <Expander Header="章节与备注（可选）" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0"><ComboBox ItemsSource="{Binding ManualChapters}" DisplayMemberPath="Name" SelectedItem="{Binding ManualChapter}"/><TextBox Text="{Binding ManualNote,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander>
       <TextBlock Text="{Binding ManualWarning}" Style="{StaticResource MutedText}"/><WrapPanel><Button Content="追加学习记录" Style="{StaticResource Primary}" Command="{Binding AddManualCommand}"/><Button Content="按明确时间区间补录" Click="KnownInterval_Click"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="查看每日详情" Click="TodayDetails_Click"/><TextBlock Text="今日记录" Style="{StaticResource Subheading}"/></DockPanel><ItemsControl ItemsSource="{Binding TodayRecords}" ItemTemplate="{StaticResource Records}"/><TextBlock Text="没有记录也没关系，随时开始下一段学习。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=1}">
      <TextBlock Text="备考历程" Style="{StaticResource Heading}"/><TextBlock Text="学习日历与每日详情 · 不要求连续打卡" Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="‹ 上月" Command="{Binding PreviousMonthCommand}"/><Button Content="下月 ›" Command="{Binding NextMonthCommand}"/></WrapPanel><TextBlock Text="{Binding MonthLabel}" Style="{StaticResource Subheading}"/></DockPanel>
       <UniformGrid Columns="7" Margin="0,0,0,12"><TextBlock Text="一" TextAlignment="Center"/><TextBlock Text="二" TextAlignment="Center"/><TextBlock Text="三" TextAlignment="Center"/><TextBlock Text="四" TextAlignment="Center"/><TextBlock Text="五" TextAlignment="Center"/><TextBlock Text="六" TextAlignment="Center"/><TextBlock Text="日" TextAlignment="Center"/></UniformGrid>
       <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.SelectDayCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Height="62" Padding="4" FontSize="12" Margin="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding InMonth}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#CDEDEE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><CheckBox Content="包含已删除记录" IsChecked="{Binding ShowDeleted}" DockPanel.Dock="Right"/><TextBlock Text="{Binding SelectedDate,StringFormat={}{0:yyyy 年 M 月 d 日} · 每日详情}" Style="{StaticResource Subheading}"/></DockPanel><ItemsControl ItemsSource="{Binding DayRecords}" ItemTemplate="{StaticResource Records}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="每日感想" Style="{StaticResource Subheading}"/><TextBlock Text="今天学到了什么？遇到了什么困难？随手写几句就好。" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Reflection,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto"/><Button Content="保存感想" HorizontalAlignment="Left" Click="SaveReflection_Click"/><TextBlock Text="输入后自动保存 · 感想修改也保留历史" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=2}">
      <TextBlock Text="计划与进度" Style="{StaticResource Heading}"/><TextBlock Text="章节完成进度与掌握情况分别记录，学习时长不会自动改变它们。" Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="＋ 科目" Click="AddSubject_Click"/><TextBlock Text="科目" Style="{StaticResource Subheading}"/></DockPanel><ItemsControl ItemsSource="{Binding AllSubjects}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="编辑 / 归档" Tag="{Binding}" Click="EditSubject_Click"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><CheckBox IsChecked="{Binding Archived,Mode=OneWay}" Content="已归档" IsEnabled="False" Margin="16,0"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="＋ 章节" Click="AddChapter_Click"/><TextBlock Text="章节" Style="{StaticResource Subheading}"/></DockPanel><ItemsControl ItemsSource="{Binding AllChapters}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Mastery,Converter={StaticResource StateLabel}}" Foreground="{StaticResource Muted}"/><CheckBox Content="已归档" IsChecked="{Binding Archived,Mode=OneWay}" IsEnabled="False"/></StackPanel><StackPanel Grid.Column="1" Margin="8"><TextBlock Text="{Binding Progress,StringFormat={}{0}%}"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,8"/></StackPanel><Button Grid.Column="2" Content="编辑" Tag="{Binding}" Click="EditChapter_Click" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="＋ 学习任务" Click="AddTask_Click"/><TextBlock Text="简单任务" Style="{StaticResource Subheading}"/></DockPanel><ItemsControl ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,8"><Button DockPanel.Dock="Right" Content="编辑" Tag="{Binding}" Click="EditTask_Click"/><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding DueDate,StringFormat=计划日期 {0:yyyy-MM-dd}}" Foreground="{StaticResource Muted}"/><CheckBox Content="已完成" IsChecked="{Binding Done,Mode=OneWay}" Tag="{Binding}" Click="TaskDone_Click"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=3}">
      <TextBlock Text="薄弱知识点" Style="{StaticResource Heading}"/><TextBlock Text="记下卡住的地方，安排复习，再验收掌握情况。" Style="{StaticResource MutedText}"/>
      <Button Content="＋ 记录薄弱点" Style="{StaticResource Primary}" Click="AddWeak_Click" HorizontalAlignment="Left"/>
      <ItemsControl ItemsSource="{Binding WeakPoints}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><DockPanel><Button DockPanel.Dock="Right" Content="编辑 / 状态" Tag="{Binding}" Click="EditWeak_Click"/><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Category,StringFormat=错误分类：{0}}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="{Binding State,Converter={StaticResource StateLabel}}" Foreground="{StaticResource Accent}" Margin="0,8"/><TextBlock Text="{Binding ReviewDate,StringFormat=后续复习：{0:yyyy-MM-dd}}"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=4}">
      <TextBlock Text="统计与复盘" Style="{StaticResource Heading}"/><TextBlock Text="按有效学习片段计算；修改记录后，统计同步更新。" Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}"><StackPanel><WrapPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="开始日期"/><DatePicker SelectedDate="{Binding StatsFrom}"/></StackPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="结束日期"/><DatePicker SelectedDate="{Binding StatsTo}"/></StackPanel><Button Content="查看统计" Command="{Binding RecalculateCommand}" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="{Binding StatsTotal}" FontSize="32" FontWeight="SemiBold" Margin="0,12"/><ItemsControl ItemsSource="{Binding Stats}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><Border Grid.Column="1" Width="{Binding Width}" HorizontalAlignment="Left" Background="{StaticResource Accent}" Height="12" CornerRadius="6"/><TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="未来版本可加入模考与更丰富的复盘维度。" Style="{StaticResource MutedText}" Margin="0,24,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=5}">
      <TextBlock Text="设置与数据" Style="{StaticResource Heading}"/><TextBlock Text="本地记录默认不上传；备份请另存到安全位置。" Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="考试档案与偏好" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding ExamDate}"/><TextBlock Text="{Binding ZoneId,StringFormat=统计时区：{0}}" Margin="0,12"/><TextBlock Text="历史日期保留原分配；修改时区影响新记录。每周从周一开始。" Style="{StaticResource MutedText}"/><Button Content="编辑档案与偏好" Click="Preferences_Click" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地数据" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding Database.DirectoryPath}" FontSize="12" Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,16,0,0"><Button Content="导出完整备份" Style="{StaticResource Primary}" Click="Backup_Click"/><Button Content="校验备份" Click="ValidateBackup_Click"/><Button Content="恢复完整备份" Click="RestoreBackup_Click"/><Button Content="导出 CSV" Click="Export_Click"/><Button Content="检查数据库" Click="Integrity_Click"/></WrapPanel><TextBlock Text="恢复会整体替换当前数据，不进行合并。恢复前自动保留当前完整备份。每日首次打开也会备份；同一磁盘的备份不能防止磁盘损坏。" Style="{StaticResource MutedText}"/><TextBlock Text="关闭窗口：活动计时进入托盘。明确退出：可结束保存，或暂停后退出。锁屏不自动暂停；未知电源间隙需要核对。" Style="{StaticResource MutedText}"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="1" Background="#EAF1F4" Padding="24,10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="处理中…" Foreground="{StaticResource Accent}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
