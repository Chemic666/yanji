    <ContentControl Content="暂无薄弱点；在薄弱知识点页面记录实际困难。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding ReviewWeakPoints.Count,Converter={StaticResource Empty}}" />
    <TextBlock Text="{Binding ReviewTaskSummary}" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
    <ItemsControl ItemsSource="{Binding ReviewTasks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Title}" Style="{StaticResource FocusTextBlock}" /><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Due}" Style="{StaticResource MutedText}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Border Style="{StaticResource SectionSurface}"><StackPanel>
    <TextBlock Text="真实每日感想 · 范围内回顾材料" Style="{StaticResource Subheading}" /><TextBlock Text="感想没有科目字段，保留所选日期范围内全部原文。" Style="{StaticResource MutedText}" />
    <ItemsControl ItemsSource="{Binding ReviewReflections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" /><TextBlock Text="{Binding Body}" Style="{StaticResource FocusTextBlock}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
</StackPanel>
            </StackPanel></StackPanel>
