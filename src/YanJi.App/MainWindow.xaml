  <DataTemplate x:Key="StudyPartRow"><Border Background="{DynamicResource Soft}" CornerRadius="8" Padding="12" Margin="0,0,0,8"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="排除片段" Tag="{Binding}" Click="ExcludePart_Click" Style="{StaticResource DangerButton}" x:Name="Exclude"/><Button Content="恢复片段" Tag="{Binding}" Click="RestorePart_Click" x:Name="Restore"/></WrapPanel><StackPanel><TextBlock Text="{Binding Date}" FontWeight="SemiBold"/><TextBlock Text="{Binding Time}" Margin="0,4" FontSize="11"/><TextBlock Text="{Binding Duration}" Foreground="{DynamicResource Accent}" ToolTip="{Binding Exact}"/><TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></DockPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Excluded}" Value="True"><Setter TargetName="Exclude" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Excluded}" Value="False"><Setter TargetName="Restore" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="208"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="14,24,14,16">
   <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="研迹" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Accent}" x:Name="BrandWord"/><TextBlock Text="YANJI / 2028" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" x:Name="BrandHint"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Button Content="退出应用" Click="Exit_Click" x:Name="ExitButton" Style="{StaticResource QuietButton}"/><TextBlock Text="V0.1.1 · 离线" FontSize="11" Foreground="{DynamicResource Muted}" x:Name="VersionHint" Margin="10,8,0,0"/></StackPanel>
   <ListBox x:Name="NavigationList" SelectedIndex="{Binding Page}" BorderThickness="0" Background="Transparent" SelectionChanged="Navigation_Changed" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBoxItem ToolTip="今日学习"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="今日学习" Tag="NavLabel"/></StackPanel></ListBoxItem>
    <ListBoxItem ToolTip="备考历程"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="备考历程" Tag="NavLabel"/></StackPanel></ListBoxItem>
    <ListBoxItem ToolTip="计划与进度"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="计划与进度" Tag="NavLabel"/></StackPanel></ListBoxItem>
    <ListBoxItem ToolTip="薄弱知识点"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="薄弱知识点" Tag="NavLabel"/></StackPanel></ListBoxItem>
    <ListBoxItem ToolTip="统计与复盘"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="统计与复盘" Tag="NavLabel"/></StackPanel></ListBoxItem>
    <ListBoxItem ToolTip="设置与数据"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="设置与数据" Tag="NavLabel"/></StackPanel></ListBoxItem>
    <ListBoxItem ToolTip="学习记录明细"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28"/><TextBlock Text="学习记录" Tag="NavLabel"/></StackPanel></ListBoxItem>
   </ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,8"><Grid IsEnabled="{Binding Busy,Converter={StaticResource Inverse}}">
    <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=0}">
     <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="＋ 快速补录" Style="{StaticResource Primary}" Click="QuickAdd_Click"/><Button Content="区间补录" Click="KnownInterval_Click"/><Button Content="学习记录" Click="TodayRecords_Click"/></WrapPanel><StackPanel><TextBlock Text="今日学习" Style="{StaticResource Heading}"/><TextBlock Text="每一段投入，都有迹可循。" Style="{StaticResource MutedText}"/></StackPanel></DockPanel>
