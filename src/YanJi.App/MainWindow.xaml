              <Button DockPanel.Dock="Right" Content="＋ 快速补录" Click="QuickAdd_Click" Style="{StaticResource Primary}" />
              <TextBlock Text="学习记录明细" Style="{StaticResource Heading}" />
            </DockPanel>
            <TextBlock Text="查看和修正学习记录，日历与统计会同步更新。" Style="{StaticResource MutedText}" />
            <Border Style="{StaticResource FilterBar}">
              <WrapPanel>
                <StackPanel Margin="0,4,12,0">
                  <TextBlock Text="记录开始日期" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <DatePicker SelectedDate="{Binding RecordFrom}" Width="140" ToolTip="记录开始日期" Margin="0,0,0,8" AutomationProperties.Name="记录开始日期" Style="{StaticResource FocusDatePicker}" />
                </StackPanel>
                <StackPanel Margin="0,4,12,0">
                  <TextBlock Text="记录结束日期" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <DatePicker SelectedDate="{Binding RecordTo}" Width="140" ToolTip="记录结束日期" Margin="0,0,0,8" AutomationProperties.Name="记录结束日期" Style="{StaticResource FocusDatePicker}" />
                </StackPanel>
                <StackPanel Margin="0,4,12,0">
                  <TextBlock Text="记录科目" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <ComboBox ItemsSource="{Binding SubjectFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordSubjectId}" Width="145" Margin="0,0,0,8" AutomationProperties.Name="记录科目" Style="{StaticResource FocusComboBox}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,4,12,0">
                  <TextBlock Text="章节筛选，图表钻取后也持续保留" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <ComboBox ItemsSource="{Binding ChapterFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordChapterId}" Width="160" ToolTip="章节筛选，图表钻取后也持续保留" Margin="0,0,0,8" AutomationProperties.Name="章节筛选，图表钻取后也持续保留" Style="{StaticResource FocusComboBox}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,4,12,0">
                  <TextBlock Text="记录来源" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <ComboBox ItemsSource="{Binding SourceFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordSource}" Width="130" Margin="0,0,0,8" AutomationProperties.Name="记录来源" Style="{StaticResource FocusComboBox}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0">
                  <TextBlock Text="记录状态" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <ComboBox ItemsSource="{Binding RecordStates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordState}" Width="125" Margin="0,0,0,8" AutomationProperties.Name="记录状态" Style="{StaticResource FocusComboBox}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
              </WrapPanel>
            </Border>
            <TextBlock Text="{Binding RecordSummary}" Style="{StaticResource MutedText}" />
            <Border Style="{StaticResource SectionSurface}">
              <StackPanel>
                <ListBox x:Name="RecordList" ItemsSource="{Binding FilteredRecords}" ItemTemplate="{StaticResource StudySessionRow}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="500" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource RecordItem}" />
                <ContentControl Content="当前筛选没有记录。可调整日期或查看已删除记录。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding FilteredRecords.Count,Converter={StaticResource Empty}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="24,8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="处理中…" Foreground="{DynamicResource Accent}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" Style="{StaticResource FocusTextBlock}" />
          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Style="{StaticResource FocusTextBlock}" />
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.ColumnSpan="2" Background="#66000000" Visibility="{Binding DrawerOpen,Converter={StaticResource BoolVisibility}}" x:Name="DetailDrawer" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Style="{StaticResource SectionSurface}" x:Name="DrawerSurface" Width="620" HorizontalAlignment="Right" Margin="16" Padding="24">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" x:Name="DrawerCloseButton" Content="关闭 ×" Click="CloseDrawer_Click" Style="{StaticResource FocusButton}" />
            <StackPanel>
              <TextBlock Text="学习记录详情" Style="{StaticResource Subheading}" />
              <TextBlock Text="{Binding SelectedRecord.Subject}" FontSize="22" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
            </StackPanel>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="知识节点 →" Click="RecordKnowledge_Click" Style="{StaticResource QuietButton}" />
            <Button Content="薄弱点关联" Click="RecordWeakLinks_Click" Style="{StaticResource QuietButton}" />
            <Button Content="编辑整次记录" Tag="{Binding SelectedRecord}" Click="EditRecord_Click" Style="{StaticResource Primary}" />
            <Button Content="删除整次记录" Tag="{Binding SelectedRecord}" Click="DeleteRecord_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding SelectedRecord.Deleted,Converter={StaticResource Inverse}}" />
            <Button Content="恢复整次记录" Tag="{Binding SelectedRecord}" Click="RestoreRecord_Click" Visibility="{Binding SelectedRecord.Deleted,Converter={StaticResource BoolVisibility}}" Style="{StaticResource FocusButton}" />
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding SelectedRecord.ScopeLabel}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,12" Style="{StaticResource FocusTextBlock}" />
              <TextBlock Text="{Binding SelectedRecord.Summary}" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding SelectedRecord.Chapter}" Style="{StaticResource MutedText}" />
              <TextBlock Text="{Binding SelectedRecord.LearningEvidence}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,12" />
              <TextBlock Text="{Binding SelectedRecord.Record.Note}" Margin="0,0,0,16" Style="{StaticResource FocusTextBlock}" />
              <TextBlock Text="有效学习片段" Style="{StaticResource Subheading}" />
              <TextBlock Text="仅排除选中的片段及对应日期。若只剩一段，请删除整条记录；之后仍可恢复。" Style="{StaticResource MutedText}" />
              <ItemsControl ItemsSource="{Binding DetailParts}" ItemTemplate="{StaticResource StudyPartRow}" />
              <Expander Header="已排除片段 · 可恢复" IsExpanded="True" Style="{StaticResource FocusExpander}">
                <ItemsControl ItemsSource="{Binding ExcludedDetailParts}" ItemTemplate="{StaticResource StudyPartRow}" />
              </Expander>
              <Expander Header="修订历史" IsExpanded="False" Style="{StaticResource FocusExpander}">
                <TextBlock Text="{Binding RevisionText}" FontSize="12" Foreground="{DynamicResource Muted}" Style="{StaticResource FocusTextBlock}" />
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
