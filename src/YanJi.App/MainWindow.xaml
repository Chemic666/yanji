     <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="StatsLeft" Width="*"/><ColumnDefinition x:Name="StatsGap" Width="16"/><ColumnDefinition x:Name="StatsRight" Width="1.15*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="科目投入占比" Style="{StaticResource Subheading}"/><local:StudyChart x:Name="SubjectDonut" Mode="Donut" Data="{Binding SubjectPlot}" PointInvoked="Chart_Drill"/><TextBlock Text="悬停查看精确时长；点击科目查看记录。" Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Grid.Column="2" x:Name="StatsDailyCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="每日科目投入" Style="{StaticResource Subheading}"/><local:StudyChart x:Name="DailyStack" Mode="Stacked" Data="{Binding DailyPlot}" PointInvoked="Chart_Drill"/><WrapPanel><TextBlock Text="{Binding StatsDays,StringFormat={}{0} 个学习日}" Margin="0,0,12,0"/><TextBlock Text="{Binding StatsSessions,StringFormat={}{0} 次学习}"/></WrapPanel><TextBlock Text="纵轴为实际时长，非归一化百分比；颜色对应科目。" Style="{StaticResource MutedText}"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="130" SelectedValue="{Binding TrendPeriod}" SelectedValuePath="Tag"><ComboBoxItem Content="按周趋势" Tag="week"/><ComboBoxItem Content="按月趋势" Tag="month"/></ComboBox><TextBlock Text="学习节奏" Style="{StaticResource Subheading}"/></DockPanel><local:StudyChart x:Name="TrendChart" Data="{Binding TrendPlot}" Mode="Trend" PointInvoked="Chart_Drill"/><TextBlock Text="首尾周期仅统计所选范围。左右键选点，Enter 查看明细。" Style="{StaticResource MutedText}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="范围学习热力" Style="{StaticResource Subheading}"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><local:StudyChart Data="{Binding StatsHeatmap}" Mode="Heatmap" Width="{Binding StatsHeatmap,Converter={StaticResource HeatWidth}}" PointInvoked="Chart_Drill"/></ScrollViewer><TextBlock Text="深浅由真实时长决定；悬停显示精确值。零数据不会伪造比例。" Style="{StaticResource MutedText}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="章节投入与计划概况" Style="{StaticResource Subheading}"/><ItemsControl ItemsSource="{Binding ChapterPlot}"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="ChapterDrill_Click" HorizontalContentAlignment="Stretch" Style="{StaticResource QuietButton}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Duration}"/><TextBlock Text="{Binding Label}"/></DockPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="章节投入按有效时长统计，点击查看原始记录。" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding TaskSummary}" Style="{StaticResource MutedText}"/><TextBlock Text="投入只代表学习时间；不自动更新掌握程度。" Style="{StaticResource MutedText}"/></StackPanel></Border>
    </StackPanel>
    <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=5}">
     <TextBlock Text="设置与数据" Style="{StaticResource Heading}"/><TextBlock Text="把数据留在本机，把选择留给自己。" Style="{StaticResource MutedText}"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="考试档案" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding ExamDate}" FontSize="16"/><TextBlock Text="{Binding ZoneId,StringFormat=统计时区：{0}}" Style="{StaticResource MutedText}" Margin="0,8"/><Button Content="编辑档案与计时偏好" Click="Preferences_Click" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="界面与主题" Style="{StaticResource Subheading}"/><CheckBox Content="深色主题" IsChecked="{Binding DarkTheme}"/><TextBlock Text="浅色与深色即时切换，选择保存在本机。窄窗口自动折叠侧栏与并排卡片。" Style="{StaticResource MutedText}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="计时偏好" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding CheckpointLabel}"/><TextBlock Text="暂停不计时；关闭窗口进入托盘；明确退出可结束保存或暂停后退出。锁屏不自动暂停，休眠与异常间隙需要核对。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据备份与恢复" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding Database.DirectoryPath}" FontSize="11" Foreground="{DynamicResource Muted}"/><WrapPanel Margin="0,16,0,4"><Button Content="导出完整备份" Style="{StaticResource Primary}" Click="Backup_Click"/><Button Content="校验备份" Click="ValidateBackup_Click"/><Button Content="恢复完整备份" Click="RestoreBackup_Click" Style="{StaticResource DangerButton}"/><Button Content="导出 CSV" Click="Export_Click"/><Button Content="检查数据库" Click="Integrity_Click"/></WrapPanel><TextBlock Text="完整恢复整体替换，不合并；先校验，再自动备份当前库并保留回退副本。CSV 不能替代备份。每日快照不自动清理，同一磁盘不能防止磁盘故障。" Style="{StaticResource MutedText}"/></StackPanel></Border>
    </StackPanel>
    <StackPanel Visibility="{Binding Page,Converter={StaticResource PageVisibility},ConverterParameter=6}">
     <DockPanel><Button DockPanel.Dock="Right" Content="＋ 快速补录" Click="QuickAdd_Click" Style="{StaticResource Primary}"/><TextBlock Text="学习记录明细" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="从统计回到事实，修正一条记录，所有视图同步更新。" Style="{StaticResource MutedText}"/>
     <Border Style="{StaticResource FilterBar}"><WrapPanel><DatePicker SelectedDate="{Binding RecordFrom}" Width="140" ToolTip="记录开始日期" Margin="0,4,12,0"/><DatePicker SelectedDate="{Binding RecordTo}" Width="140" ToolTip="记录结束日期" Margin="0,4,12,0"/><ComboBox ItemsSource="{Binding SubjectFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordSubjectId}" Width="145" Margin="0,4,12,0"/><ComboBox ItemsSource="{Binding ChapterFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordChapterId}" Width="160" ToolTip="章节筛选，图表钻取后也持续保留" Margin="0,4,12,0"/><ComboBox ItemsSource="{Binding SourceFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordSource}" Width="130" Margin="0,4,12,0"/><ComboBox ItemsSource="{Binding RecordStates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RecordState}" Width="125" Margin="0,4,0,0"/></WrapPanel></Border>
     <TextBlock Text="{Binding RecordSummary}" Style="{StaticResource MutedText}"/>
     <Border Style="{StaticResource Card}"><StackPanel><ListBox x:Name="RecordList" ItemsSource="{Binding FilteredRecords}" ItemTemplate="{StaticResource StudySessionRow}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="500" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></ListBox.ItemContainerStyle></ListBox><ContentControl Content="当前筛选没有记录。可调整日期或查看已删除记录。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding FilteredRecords.Count,Converter={StaticResource Empty}}"/></StackPanel></Border>
    </StackPanel>
   </Grid></ScrollViewer>
   <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,8"><DockPanel><TextBlock DockPanel.Dock="Right" Text="处理中…" Foreground="{DynamicResource Accent}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></DockPanel></Border>
  </Grid>
  <Grid Grid.ColumnSpan="2" Background="#66000000" Visibility="{Binding DrawerOpen,Converter={StaticResource BoolVisibility}}" x:Name="DetailDrawer"><Border Style="{StaticResource Card}" Width="620" HorizontalAlignment="Right" Margin="16" Padding="24"><DockPanel><DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="关闭 ×" Click="CloseDrawer_Click"/><StackPanel><TextBlock Text="学习记录详情" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding SelectedRecord.Subject}" FontSize="22" FontWeight="SemiBold"/></StackPanel></DockPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="编辑整次记录" Tag="{Binding SelectedRecord}" Click="EditRecord_Click" Style="{StaticResource Primary}"/><Button Content="删除整次记录" Tag="{Binding SelectedRecord}" Click="DeleteRecord_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding SelectedRecord.Deleted,Converter={StaticResource Inverse}}"/><Button Content="恢复整次记录" Tag="{Binding SelectedRecord}" Click="RestoreRecord_Click" Visibility="{Binding SelectedRecord.Deleted,Converter={StaticResource BoolVisibility}}"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SelectedRecord.ScopeLabel}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,12"/><TextBlock Text="{Binding SelectedRecord.Summary}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedRecord.Chapter}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedRecord.Record.Note}" Margin="0,0,0,16"/><TextBlock Text="有效学习片段" Style="{StaticResource Subheading}"/><TextBlock Text="排除仅影响选中片段与对应日期；最后一段请使用整次软删除。" Style="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding DetailParts}" ItemTemplate="{StaticResource StudyPartRow}"/><Expander Header="已排除片段 · 可恢复" IsExpanded="True"><ItemsControl ItemsSource="{Binding ExcludedDetailParts}" ItemTemplate="{StaticResource StudyPartRow}"/></Expander><Expander Header="修订历史" IsExpanded="True"><TextBlock Text="{Binding RevisionText}" FontSize="12" Foreground="{DynamicResource Muted}"/></Expander></StackPanel></ScrollViewer></DockPanel></Border></Grid>
 </Grid>
</Window>
