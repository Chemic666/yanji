 <Window.Resources>
  <local:PageVisibilityConverter x:Key="PageVisibility"/><local:InverseBooleanConverter x:Key="Inverse"/><BooleanToVisibilityConverter x:Key="BoolVisibility"/><local:EmptyVisibilityConverter x:Key="Empty"/><local:HeatWidthConverter x:Key="HeatWidth"/>
  <Style TargetType="local:MetricCard"><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MetricCard"><Border Style="{StaticResource Card}" Margin="0" Padding="16"><StackPanel><TextBlock Text="{TemplateBinding Label}" Foreground="{DynamicResource Muted}" FontSize="12"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="32" Margin="0,8,0,8"><TextBlock Text="{TemplateBinding Value}" TextWrapping="NoWrap" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" ToolTip="{TemplateBinding Value}"/></Viewbox><TextBlock Text="{TemplateBinding Hint}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
