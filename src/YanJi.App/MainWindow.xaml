</StackPanel>
<StackPanel x:Name="StudyReviewSection"><TextBlock Text="学习复盘" Style="{StaticResource Subheading}" />
  <TextBlock Text="{Binding ReviewFactSummary}" Style="{StaticResource FocusTextBlock}" Margin="0,0,0,4" />
  <TextBlock Text="{Binding ReviewSnapshotSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
  <Border Style="{StaticResource SectionSurface}">
    <StackPanel>
      <TextBlock Text="阶段复盘" Style="{StaticResource Subheading}" />
      <TextBlock Text="{Binding ReviewEditorLabel}" Style="{StaticResource MutedText}" />
      <TextBox x:Name="ReviewEditor" Text="{Binding ReviewBody,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" MaxLength="20000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="阶段复盘正文" Style="{StaticResource FocusTextBox}" />
      <WrapPanel><Button Content="保存阶段复盘" Click="SaveReview_Click" Style="{StaticResource Primary}" /><Button Content="新建复盘" Click="NewReview_Click" Style="{StaticResource QuietButton}" /><CheckBox Content="显示已删除复盘" IsChecked="{Binding ShowDeletedReviews}" VerticalAlignment="Center" /></WrapPanel>
      <TextBlock Text="独立保存范围、科目、正文与修订；每日感想是回顾材料，不推断效率。" Style="{StaticResource MutedText}" />
    </StackPanel>
  </Border>
  <ItemsControl ItemsSource="{Binding PeriodReviews}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource DenseSurface}"><StackPanel>
      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Style="{StaticResource FocusTextBlock}" />
      <TextBlock Text="{Binding Body}" Margin="0,8" Style="{StaticResource FocusTextBlock}" />
      <Button Content="关联学习记录" Tag="{Binding}" Click="ReviewRecords_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
      <WrapPanel><Button Content="查看 / 编辑" Tag="{Binding}" Click="EditReview_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Review.Deleted}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="删除" Tag="{Binding}" Click="DeleteReview_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Review.Deleted}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="恢复" Tag="{Binding}" Click="RestoreReview_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Review.Deleted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
    </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <ContentControl Content="用上方输入记录这一阶段的收获与下一步。" ContentTemplate="{StaticResource EmptyState}" Visibility="{Binding PeriodReviews.Count,Converter={StaticResource Empty}}" />
