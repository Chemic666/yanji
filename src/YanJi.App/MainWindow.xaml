   <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{Binding Subject}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ScopeLabel}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,4" ToolTip="{Binding Allocation}"/><TextBlock Text="{Binding Chapter}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Note}" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.Note}" Margin="0,4,0,0"/></StackPanel>
   <WrapPanel Grid.Column="3" Width="164" VerticalAlignment="Center"><Button Content="查看" Tag="{Binding}" Click="Detail_Click" Style="{StaticResource QuietButton}"/><Button Content="编辑" Tag="{Binding}" Click="EditRecord_Click" Style="{StaticResource QuietButton}"/><Button Content="历史" Tag="{Binding}" Click="History_Click" Style="{StaticResource QuietButton}"/>
    <Button Content="删除" Tag="{Binding}" Click="DeleteRecord_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DangerButton}"><Style.Triggers><DataTrigger Binding="{Binding Deleted}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Content="恢复" Tag="{Binding}" Click="RestoreRecord_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Deleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   </WrapPanel></Grid></Border></DataTemplate>
