<Window x:Class="YanJi.App.KnowledgePackageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YanJi.App" Title="研迹 · 知识包" Width="1200" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="KnowledgeTreeStyles.xaml" /></ResourceDictionary.MergedDictionaries>
      <local:InverseBooleanConverter x:Key="Inverse" />
      <Style TargetType="ListBoxItem" BasedOn="{StaticResource RecordItem}" />
      <HierarchicalDataTemplate DataType="{x:Type local:KnowledgeTreeRow}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" Style="{StaticResource FocusTextBlock}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" /></HierarchicalDataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <Button Content="导入 JSON 文件" Click="Import_Click" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" IsEnabled="{Binding Busy,Converter={StaticResource Inverse}}" />
      <StackPanel><TextBlock Text="知识包" Style="{StaticResource Heading}" /><TextBlock Text="参考目录 · 可预览 · 保护本地修改" Style="{StaticResource MutedText}" /></StackPanel>
    </DockPanel>
    <TabControl x:Name="PackageTabs" Grid.Row="1" SelectedIndex="{Binding TabIndex}" Background="Transparent" BorderBrush="{DynamicResource Line}" IsEnabled="{Binding Busy,Converter={StaticResource Inverse}}">
      <TabItem Header="浏览与导入">
        <Grid Margin="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12"><TextBlock Text="参考目录 · 可选按科目筛选" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{Binding CatalogSubjects}" SelectedItem="{Binding FilterSubject}" DisplayMemberPath="Name" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="筛选参考模板科目" /></StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Catalog}" SelectedItem="{Binding SelectedCatalog}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,10" MaxWidth="200"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding InstallStatus}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding PackageName}" Style="{StaticResource Subheading}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="{Binding InstallHint}" Style="{StaticResource MutedText}" /><Button Content="已安装 · 查看目录 →" Command="{Binding ViewDirectoryCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" IsEnabled="{Binding HasInstalledPackage}" Margin="0,0,0,12" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" LineHeight="22" Margin="0,0,0,16" />
                <TextBlock Text="安装到考试档案" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" DisplayMemberPath="Name" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="知识包目标考试档案" />
                <ItemsControl ItemsSource="{Binding Targets}" Margin="0,8,0,12"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="知识包科目安装目标" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="知识树预览" Style="{StaticResource Subheading}" Margin="0,0,0,8" />
                <TreeView x:Name="PreviewTree" ItemsSource="{Binding Roots}" Height="200" Foreground="{DynamicResource Ink}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                <Expander Header="来源、适用范围与许可" Foreground="{DynamicResource Ink}" Margin="0,12,0,0"><TextBlock Text="{Binding SourceText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,12" /></Expander>
              </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="2" Content="生成安装 / 更新预览" Command="{Binding PreviewCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,12,0,0" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="已安装与历史">
        <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <ListBox ItemsSource="{Binding Installed}" SelectedItem="{Binding SelectedInstall}" Background="Transparent" BorderBrush="{DynamicResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,12"><TextBlock Text="{Binding PackageId}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" /><TextBlock Text="{Binding Version,StringFormat=当前版本：{0}}" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="目录操作历史" Style="{StaticResource Subheading}" Margin="0,0,0,12" /><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" LineHeight="24" /></ScrollViewer>
            <WrapPanel Grid.Row="2"><Button Content="查看目录 →" Command="{Binding ViewInstalledCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="预览安全回滚" Command="{Binding RollbackCommand}" Style="{StaticResource QuietButton}" /></WrapPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="差异与确认">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Subheading}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width=".8*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding ChangeRows}" Background="Transparent" BorderBrush="{DynamicResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" Margin="8,10" /></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ListBox Grid.Column="2" ItemsSource="{Binding Conflicts}" Background="Transparent" BorderBrush="{DynamicResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,10"><TextBlock Text="{Binding Label}" FontWeight="Medium" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" /><TextBlock Text="{Binding Values}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8" /><ComboBox ItemsSource="{x:Static local:PackageConflictRow.Options}" SelectedIndex="{Binding ChoiceIndex}" IsEnabled="{Binding Selectable}" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="知识包冲突处理选择" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="确认应用目录变更" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Style="{StaticResource Primary}" DockPanel.Dock="Right" /><Button Content="重新检查冲突选择" Command="{Binding ResolveCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" /><TextBlock Text="学习记录、时长和掌握状态不属于模板。" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" MaxHeight="64" ToolTip="{Binding Feedback}" />
  </Grid>
</Window>
