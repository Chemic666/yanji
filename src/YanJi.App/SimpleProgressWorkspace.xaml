<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="YanJi.App.SimpleProgressWorkspace" Loaded="Workspace_Loaded">
  <StackPanel KeyboardNavigation.TabNavigation="Continue">
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="STUDY JOURNAL / 学习进度" Style="{StaticResource StudioEyebrow}" />
      <TextBlock Text="学到哪里，记在这里。" Style="{StaticResource StudioTitle}" />
      <TextBlock Text="不急着完成所有章节，先记下今天的一小步。" Style="{StaticResource StudioSubtitle}" />
    </StackPanel>
    <Grid Margin="0,0,0,20" SizeChanged="Journal_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="JournalMain" Width="*" />
        <ColumnDefinition x:Name="JournalGap" Width="24" />
        <ColumnDefinition x:Name="JournalAside" Width="232" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource StudioSurface}" Padding="24,4" Margin="0">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource SectionSurface}" Padding="0,18" Margin="0" Background="Transparent" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" CornerRadius="0">
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource Accent}" FontSize="12" />
                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" />
                  </DockPanel>
                  <TextBlock Text="{Binding Current}" TextWrapping="Wrap" FontSize="17" Margin="0,8,0,4" MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Current}" />
                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" MaxHeight="40" ToolTip="{Binding Content}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Content}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Next,StringFormat=下一步：{0}}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Next}" Margin="0,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Next}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Recent,StringFormat=最近学习：{0}}" Style="{StaticResource MutedText}" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Recent}" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="更新进度" Tag="{Binding}" Click="Update_Click" Style="{StaticResource StudioSecondary}" />
                    <Button Content="开始学习" Tag="{Binding}" Click="Start_Click" Style="{StaticResource FocusButton}" />
                    <Button Content="查看章节" Tag="{Binding}" Click="Browse_Click" Style="{StaticResource QuietButton}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <StackPanel x:Name="RecentAside" Grid.Column="2" Margin="0,12,0,0">
        <TextBlock Text="最近停留的地方" Style="{StaticResource StudioEyebrow}" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Tag="{Binding}" Click="Browse_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,14" Padding="0,8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Subheading}" />
                  <TextBlock Text="{Binding Current}" Style="{StaticResource StudioSubtitle}" MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Current}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="学习进度由你确认。投入时长、完成任务与知识掌握分别记录。" Style="{StaticResource StudioSubtitle}" />
      </StackPanel>
    </Grid>
    <Expander x:Name="SubjectSettings" Header="科目与目录设置 · 考试范围、参考目录" Style="{StaticResource FocusExpander}">
      <StackPanel>
        <WrapPanel Margin="0,0,0,12">
          <StackPanel Margin="0,0,16,0">
            <TextBlock Text="数学参考范围" Style="{StaticResource MutedText}" />
            <ComboBox x:Name="MathRange" Width="200" SelectedIndex="0" SelectionChanged="Range_Changed" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="数学参考范围">
              <ComboBoxItem Content="尚未确定 · 共同基础" />
              <ComboBoxItem Content="数学一" />
              <ComboBoxItem Content="数学二" />
              <ComboBoxItem Content="查看全部范围" />
            </ComboBox>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="英语参考范围" Style="{StaticResource MutedText}" />
            <ComboBox x:Name="EnglishRange" Width="200" SelectedIndex="0" SelectionChanged="Range_Changed" Style="{StaticResource FocusComboBox}" AutomationProperties.Name="英语参考范围">
              <ComboBoxItem Content="尚未确定 · 共同基础" />
              <ComboBoxItem Content="英语一" />
              <ComboBoxItem Content="英语二" />
              <ComboBoxItem Content="查看全部范围" />
            </ComboBox>
          </StackPanel>
        </WrapPanel>
        <Button Content="应用参考目录" Click="Presets_Click" Style="{StaticResource FocusButton}" HorizontalAlignment="Left" />
        <TextBlock Text="已有目录和本地修改会保留；完整知识包管理在下方完整目录中。" Style="{StaticResource MutedText}" />
      </StackPanel>
    </Expander>
    <TextBlock Text="进度可以独立保存，不产生学习时长；已学习也不等于掌握或验收通过。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
  </StackPanel>
</UserControl>
