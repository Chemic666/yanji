<Window x:Class="YanJi.App.MiniTimerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YanJi.App" Title="研迹 · 悬浮专注" Width="420" Height="244" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual" PreviewKeyDown="Mini_KeyDown">
  <Window.Resources><BooleanToVisibilityConverter x:Key="MiniVisible" /></Window.Resources>
  <Grid Margin="10" MouseLeftButtonDown="DragPanel_MouseLeftButtonDown">
    <Border Background="#09000000" CornerRadius="23" Margin="0,3,0,-3" IsHitTestVisible="False" />
    <Border Background="#09000000" CornerRadius="21" Margin="1,1,1,-1" IsHitTestVisible="False" />
    <Border x:Name="FloatingPanel" Background="{DynamicResource MiniSurface}" BorderBrush="{DynamicResource MiniEdge}" BorderThickness="1" CornerRadius="22" Padding="20,14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="RuntimeHint" DockPanel.Dock="Right" Text="研迹 · 专注" Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0"/><TextBlock Text="{Binding TimerSubject.Name}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" FontSize="14" TextTrimming="CharacterEllipsis"/></DockPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding TimerText}" FontSize="54" FontWeight="Light" Foreground="{DynamicResource Ink}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" AutomationProperties.AutomationId="MiniDigits"/>
          <TextBlock Text="{Binding TimerChapter.Name}" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0" ToolTip="{Binding TimerChapter.Name}"/>
          <TextBlock Text="{Binding TimerStateText}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2"><TextBlock x:Name="ToolbarHint" Text="悬停或 Tab 显示操作 · 拖动面板移动" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
          <Border x:Name="Toolbar" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="0,4">
            <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <WrapPanel HorizontalAlignment="Center">
              <Button Content="开始" Visibility="{Binding CanStartFocus,Converter={StaticResource MiniVisible}}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartFocus}" Style="{StaticResource Primary}" Padding="10,4" MinHeight="32" Margin="0,0,6,0" ToolTip="开始学习"/>
              <Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPauseFocus}" Style="{StaticResource SecondaryButton}" Padding="8,4" MinHeight="32" Margin="0,0,6,0"/>
              <Button Content="结束" Command="{Binding FinishCommand}" IsEnabled="{Binding TimerActive}" Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" Margin="0,0,4,0"/>
              <Button Content="↗" Click="Main_Click" Style="{StaticResource IconButton}" ToolTip="返回主窗口" AutomationProperties.Name="返回主窗口" Margin="0,0,4,0"/>
              <CheckBox Content="置顶" IsChecked="{Binding Topmost,RelativeSource={RelativeSource AncestorType=Window}}" Checked="Pin_Changed" Unchecked="Pin_Changed" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
              <Button Content="×" Click="Hide_Click" Style="{StaticResource IconButton}" ToolTip="隐藏迷你窗，计时继续" AutomationProperties.Name="隐藏迷你窗口" Margin="0"/>
            </WrapPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
