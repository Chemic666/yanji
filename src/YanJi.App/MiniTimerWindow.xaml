<Window x:Class="YanJi.App.MiniTimerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YanJi.App" Title="研迹 · 专注" Width="440" Height="330" MinWidth="380" MinHeight="300" ShowInTaskbar="False" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" PreviewKeyDown="Mini_KeyDown">
  <Grid Margin="20,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><CheckBox DockPanel.Dock="Right" Content="置顶" IsChecked="{Binding Topmost,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FocusCheckBox}"/><TextBlock Text="{Binding FocusTaskLabel}" TextWrapping="Wrap" MaxHeight="44" Style="{StaticResource FocusTextBlock}" ToolTip="{Binding FocusTaskLabel}"/></DockPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock Text="{Binding TimerText}" FontSize="44" Foreground="{DynamicResource Accent}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Style="{StaticResource FocusTextBlock}"/>
      <TextBlock Text="{Binding FocusSubjectLabel}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding TimerStateText}" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding FocusRemainingText}" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><WrapPanel HorizontalAlignment="Center">
      <Button Content="{Binding FocusStartLabel}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartFocus}" Style="{StaticResource Primary}"/>
      <Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPauseFocus}" Style="{StaticResource FocusButton}"/>
      <Button Content="结束" Command="{Binding FinishCommand}" IsEnabled="{Binding TimerActive}" Style="{StaticResource QuietButton}"/>
      <Button Content="主窗口" Click="Main_Click" Style="{StaticResource QuietButton}"/>
    </WrapPanel><TextBlock Text="关闭此窗仅隐藏 · Ctrl+Space 暂停或继续" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
  </Grid>
</Window>
